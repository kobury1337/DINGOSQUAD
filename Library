-- --------------------------------------------------------------------------
-- Utility functions
-- --------------------------------------------------------------------------
local function createInstance(className, parent, properties)
	local inst = Instance.new(className)
	for prop, val in pairs(properties) do
		inst[prop] = val
	end
	inst.Parent = parent
	return inst
end

local function createUIStroke(parent, thickness, color)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = thickness
	stroke.Color = color
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Miter
	stroke.Parent = parent
	return stroke
end

local function createUIAspectRatioConstraint(parent)
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.Parent = parent
	return ar
end

-- Clamp number
local function clamp(val, min, max)
	return math.max(min, math.min(max, val))
end

-- --------------------------------------------------------------------------
-- File system (executor workspace)
-- --------------------------------------------------------------------------
local CONFIG_FOLDER = "DINGOSQUAD/Configs/"

local function ensureConfigFolder()
	if not isfolder then return false end
	if not isfolder(CONFIG_FOLDER) then
		makefolder(CONFIG_FOLDER)
	end
	return true
end

local function saveConfig(name, data)
	if not ensureConfigFolder() then return false end
	local path = CONFIG_FOLDER .. name .. ".ds"
	local success, err = pcall(writefile, path, game:GetService("HttpService"):JSONEncode(data))
	return success
end

local function loadConfig(name)
	if not ensureConfigFolder() then return nil end
	local path = CONFIG_FOLDER .. name .. ".ds"
	if not isfile(path) then return nil end
	local content = readfile(path)
	local success, data = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), content)
	if success then return data else return nil end
end

local function listConfigs()
	if not ensureConfigFolder() then return {} end
	local files = listfiles(CONFIG_FOLDER)
	local names = {}
	for _, file in ipairs(files) do
		if file:match("%.ds$") then
			local name = file:gsub("^" .. CONFIG_FOLDER, ""):gsub("%.ds$", "")
			table.insert(names, name)
		end
	end
	return names
end

