    function menu.saveconfig()
        local name = menu.options["Settings"]["Configuration"]["ConfigName"][1]
        writefile(ConfigPath(name), SaveCurSettings())
        CreateNotification('Saved "'..name..'.DS"!')
        UpdateConfigs()
    end

    function menu.loadconfig()
        local name = menu.options["Settings"]["Configuration"]["ConfigName"][1]
        local path = ConfigPath(name)
        if not isfile(path) then
            CreateNotification('"'..name..'.DS" is not a valid config.')
            return
        end
        local curcfg = SaveCurSettings()
        local loaded = readfile(path)
        if pcall(LoadConfig, loaded) then
            CreateNotification('Loaded "'..name..'.DS"!')
        else
            LoadConfig(curcfg)
            CreateNotification('There was an issue loading "'..name..'.DS"')
        end
    end

    local function buttonpressed(bp)
        if bp.doubleclick then
            if buttonsInQue[bp] and tick() - buttonsInQue[bp] < doubleclickDelay then
                buttonsInQue[bp] = 0
            else
                for button in next, buttonsInQue do buttonsInQue[button] = 0 end
                buttonsInQue[bp] = tick()
                return
            end
        end
        FireEvent("bb_buttonpressed", bp.tab, bp.groupbox, bp.name)
        if bp.callback then bp.callback() end
        if bp == menu.options["Settings"]["Cheat Settings"]["Unload Cheat"] then
            menu.fading = true
            task.wait()
            menu:unload()
        elseif bp == menu.options["Settings"]["Cheat Settings"]["Set Clipboard Game ID"] then
            setclipboard(game.JobId)
        elseif bp == menu.options["Settings"]["Configuration"]["Save Config"] then
            menu.saveconfig()
        elseif bp == menu.options["Settings"]["Configuration"]["Delete Config"] then
            local name = menu.options["Settings"]["Configuration"]["ConfigName"][1]
            delfile(ConfigPath(name))
            CreateNotification('Deleted "'..name..'.DS"!')
            UpdateConfigs()
        elseif bp == menu.options["Settings"]["Configuration"]["Load Config"] then
            menu.loadconfig()
        end
    end

