    function Draw:ColorPicker(color, x, y, t)
        local tbl = {}
        Draw:MenuOutlinedRect(true, x, y, 28, 14, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+1, 26, 12, {0,0,0,255}, t)
        Draw:MenuFilledRect(true, x+2, y+2, 24, 10, {color[1], color[2], color[3], 255}, t)
        table.insert(tbl, t[#t])
        Draw:MenuOutlinedRect(true, x+2, y+2, 24, 10, {color[1]-40, color[2]-40, color[3]-40, 255}, t)
        table.insert(tbl, t[#t])
        Draw:MenuOutlinedRect(true, x+3, y+3, 22, 8, {color[1]-40, color[2]-40, color[3]-40, 255}, t)
        table.insert(tbl, t[#t])
        return tbl
    end

    function Draw:Slider(name, stradd, value, minvalue, maxvalue, customvals, rounded, x, y, length, t)
        Draw:MenuBigText(name, true, false, x, y-3, t)
        for i = 0, 3 do
            Draw:MenuFilledRect(true, x+2, y+14+(i*2), length-4, 2, {0,0,0,255}, t)
            t[#t].Color = ColorRange(i, {
                [1] = {start=0, color=RGB(50,50,50)},
                [2] = {start=3, color=RGB(30,30,30)},
            })
        end
        local tbl = {}
        for i = 0, 3 do
            Draw:MenuFilledRect(true, x+2, y+14+(i*2),
                (length-4) * ((value-minvalue)/(maxvalue-minvalue)), 2, {0,0,0,255}, t)
            table.insert(tbl, t[#t])
            t[#t].Color = ColorRange(i, {
                [1] = {start=0, color=RGB(menu.mc[1], menu.mc[2], menu.mc[3])},
                [2] = {start=3, color=RGB(menu.mc[1]-40, menu.mc[2]-40, menu.mc[3]-40)},
            })
        end
        Draw:MenuOutlinedRect(true, x, y+12, length, 12, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+13, length-2, 10, {0,0,0,255}, t)
        local textstr = ""
        if stradd == nil then stradd = "" end
        local decplaces = rounded and string.rep("0", math.log(1/rounded)/math.log(10)) or 1
        if rounded and value == math.floor(value*decplaces) then
            textstr = tostring(value).."."..decplaces..stradd
        else
            textstr = tostring(value)..stradd
        end
        Draw:MenuBigText(customvals[value] or textstr, true, true, x+(length*0.5), y+11, t)
        table.insert(tbl, t[#t])
        table.insert(tbl, stradd)
        return tbl
    end

    function Draw:Dropbox(name, value, values, x, y, length, t)
        local tbl = {}
        Draw:MenuBigText(name, true, false, x, y-3, t)
        for i = 0, 7 do
            Draw:MenuFilledRect(true, x+2, y+14+(i*2), length-4, 2, {0,0,0,255}, t)
            t[#t].Color = ColorRange(i, {
                [1] = {start=0, color=RGB(50,50,50)},
                [2] = {start=7, color=RGB(35,35,35)},
            })
        end
        Draw:MenuOutlinedRect(true, x, y+12, length, 22, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+13, length-2, 20, {0,0,0,255}, t)
        Draw:MenuBigText(tostring(values[value]), true, false, x+6, y+16, t)
        table.insert(tbl, t[#t])
        Draw:MenuBigText("-", true, false, x-17+length, y+16, t)
        table.insert(tbl, t[#t])
        return tbl
    end

    function Draw:Combobox(name, values, x, y, length, t)
        local tbl = {}
        Draw:MenuBigText(name, true, false, x, y-3, t)
        for i = 0, 7 do
            Draw:MenuFilledRect(true, x+2, y+14+(i*2), length-4, 2, {0,0,0,255}, t)
            t[#t].Color = ColorRange(i, {
                [1] = {start=0, color=RGB(50,50,50)},
                [2] = {start=7, color=RGB(35,35,35)},
            })
        end
        Draw:MenuOutlinedRect(true, x, y+12, length, 22, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+13, length-2, 20, {0,0,0,255}, t)
        local textthing = ""
        for _, v in pairs(values) do
            if v[2] then
                if textthing == "" then textthing = v[1]
                else textthing ..= ", "..v[1] end
            end
        end
        if string.len(textthing) > 25 then textthing = string_cut(textthing, 25) end
        textthing = textthing ~= "" and textthing or "None"
        Draw:MenuBigText(textthing, true, false, x+6, y+16, t)
        table.insert(tbl, t[#t])
        Draw:MenuBigText("...", true, false, x-27+length, y+16, t)
        table.insert(tbl, t[#t])
        return tbl
    end

    function Draw:Button(name, x, y, length, t)
        local tbl = {}
        for i = 0, 8 do
            Draw:MenuFilledRect(true, x+2, y+2+(i*2), length-4, 2, {0,0,0,255}, t)
            t[#t].Color = ColorRange(i, {
                [1] = {start=0, color=RGB(50,50,50)},
                [2] = {start=8, color=RGB(35,35,35)},
            })
            table.insert(tbl, t[#t])
        end
        Draw:MenuOutlinedRect(true, x, y, length, 22, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+1, length-2, 20, {0,0,0,255}, t)
        tbl.text = Draw:MenuBigText(name, true, true, x+math.floor(length*0.5), y+4, t)
        return tbl
    end

    function Draw:List(name, x, y, length, maxamount, columns, t)
        local tbl = { uparrow = {}, downarrow = {}, liststuff = { rows = {}, words = {} } }
        for i, v in ipairs(name) do
            Draw:MenuBigText(v, true, false,
                (math.floor(length/columns) * i) - math.floor(length/columns) + 30, y-3, t)
        end
        Draw:MenuOutlinedRect(true, x, y+12, length, 22*maxamount+4, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+13, length-2, 22*maxamount+2, {0,0,0,255}, t)
        Draw:MenuFilledRect(true, x+length-7, y+16, 1, 1, {menu.mc[1], menu.mc[2], menu.mc[3], 255}, t)
        table.insert(tbl.uparrow, t[#t]); table.insert(menu.clrs.norm, t[#t])
        Draw:MenuFilledRect(true, x+length-8, y+17, 3, 1, {menu.mc[1], menu.mc[2], menu.mc[3], 255}, t)
        table.insert(tbl.uparrow, t[#t]); table.insert(menu.clrs.norm, t[#t])
        Draw:MenuFilledRect(true, x+length-9, y+18, 5, 1, {menu.mc[1], menu.mc[2], menu.mc[3], 255}, t)
        table.insert(tbl.uparrow, t[#t]); table.insert(menu.clrs.norm, t[#t])
        Draw:MenuFilledRect(true, x+length-7, y+16+(22*maxamount+4)-9, 1, 1, {menu.mc[1], menu.mc[2], menu.mc[3], 255}, t)
        table.insert(tbl.downarrow, t[#t]); table.insert(menu.clrs.norm, t[#t])
        Draw:MenuFilledRect(true, x+length-8, y+16+(22*maxamount+4)-10, 3, 1, {menu.mc[1], menu.mc[2], menu.mc[3], 255}, t)
        table.insert(tbl.downarrow, t[#t]); table.insert(menu.clrs.norm, t[#t])
        Draw:MenuFilledRect(true, x+length-9, y+16+(22*maxamount+4)-11, 5, 1, {menu.mc[1], menu.mc[2], menu.mc[3], 255}, t)
        table.insert(tbl.downarrow, t[#t]); table.insert(menu.clrs.norm, t[#t])
        for i = 1, maxamount do
            tbl.liststuff.rows[i] = {}
            if i ~= maxamount then
                Draw:MenuOutlinedRect(true, x+4, (y+13)+(22*i), length-8, 2, {20,20,20,255}, t)
                table.insert(tbl.liststuff.rows[i], t[#t])
            end
            if columns ~= nil then
                for i1 = 1, columns-1 do
                    Draw:MenuOutlinedRect(true, x+math.floor(length/columns)*i1,
                        (y+13)+(22*i)-18, 2, 16, {20,20,20,255}, t)
                    table.insert(tbl.liststuff.rows[i], t[#t])
                end
            end
            tbl.liststuff.words[i] = {}
            if columns ~= nil then
                for i1 = 1, columns do
                    Draw:MenuBigText("", true, false,
                        (x+math.floor(length/columns)*i1) - math.floor(length/columns)+5,
                        (y+13)+(22*i)-16, t)
                    table.insert(tbl.liststuff.words[i], t[#t])
                end
            else
                Draw:MenuBigText("", true, false, x+5, (y+13)+(22*i)-16, t)
                table.insert(tbl.liststuff.words[i], t[#t])
            end
        end
        return tbl
    end

    function Draw:ImageWithText(size, image, text, x, y, t)
        local tbl = {}
        Draw:MenuOutlinedRect(true, x, y, size+4, size+4, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+1, size+2, size+2, {0,0,0,255}, t)
        Draw:MenuFilledRect(true, x+2, y+2, size, size, {40,40,40,255}, t)
        Draw:MenuBigText(text, true, false, x+size+8, y, t)
        table.insert(tbl, t[#t])
        Draw:MenuImage(true, image, x+2, y+2, size, size, 1, t)
        table.insert(tbl, t[#t])
        return tbl
    end

    function Draw:TextBox(name, text, x, y, length, t)
        for i = 0, 8 do
            Draw:MenuFilledRect(true, x+2, y+2+(i*2), length-4, 2, {0,0,0,255}, t)
            t[#t].Color = ColorRange(i, {
                [1] = {start=0, color=RGB(50,50,50)},
                [2] = {start=8, color=RGB(35,35,35)},
            })
        end
        Draw:MenuOutlinedRect(true, x, y, length, 22, {30,30,30,255}, t)
        Draw:MenuOutlinedRect(true, x+1, y+1, length-2, 20, {0,0,0,255}, t)
        Draw:MenuBigText(text, true, false, x+6, y+4, t)
        return t[#t]
    end
end

