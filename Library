--[[
    DINGOSQUAD
    Stage 2.1
    Button + Toggle

    Public API:

        local Library = ...

        local Window = Library:CreateWindow({
            Name = "Example Menu",
            ActivationColor = Color3.fromRGB(150, 8, 34)
        })

        local Combat = Window:CreateTab("Combat")

        Combat:CreateButton({
            Name = "Test Button",
            Callback = function()
                print("Clicked!")
            end
        })

        Combat:CreateToggle({
            Name = "God Mode",
            Default = false,
            Callback = function(Value)
                print("God Mode:", Value)
            end
        })
]]

