		FontFace = CONST.TabButton.Font,
		BackgroundTransparency = CONST.TabButton.BackgroundTransparency,
		BorderSizePixel = 0,
	})
	tabButtons[name] = btn

	-- Create tab frame
	local frame = createInstance("Frame", Library._tabFrameContainer.Parent, {
		Name = name .. "Frame",
		Size = CONST.TabFrame.Size,
		Position = CONST.TabFrame.Position,
		BackgroundColor3 = CONST.TabFrame.Background,
		BorderColor3 = CONST.TabFrame.BorderColor,
		Visible = false,
	})
	tabFrames[name] = frame

	-- Button click switches tab
	btn.MouseButton1Click:Connect(function()
		switchTab(name)
	end)

	-- Return a Tab object
	local tabObj = setmetatable({}, { __index = Tab })
	tabObj._name = name
	tabObj._frame = frame
	tabObj._controls = {}
	return tabObj
end

