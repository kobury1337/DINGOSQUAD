    -- Cleanly close any open transient UI (used by both RightShift and Menu Toggle)
    local function close_transient_ui()
        cp.dragging_m = false; cp.dragging_r = false; cp.dragging_b = false
        for _, v in pairs(menu.options) do
            for _, v1 in pairs(v) do
                for _, v2 in pairs(v1) do
                    if v2[2] == "slider" and v2[5] then v2[5] = false
                    elseif v2[2] == "dropbox" and v2[5] then v2[5] = false
                    elseif v2[2] == "combobox" and v2[5] then v2[5] = false
                    elseif v2[2] == "toggle" and v2[5] ~= nil then
                        if v2[5][2] == "keybind" and v2[5][5] then
                            v2[5][4][2].Color = RGB(30,30,30); v2[5][5] = false
                        elseif v2[5][2] == "single colorpicker" and v2[5][5] then
                            v2[5][5] = false
                        end
                    elseif v2[2] == "button" and v2[1] then
                        for i = 0, 8 do
                            v2[4][i+1].Color = ColorRange(i, {
                                [1] = {start=0, color=RGB(50,50,50)},
                                [2] = {start=8, color=RGB(35,35,35)},
                            })
                        end
                        v2[1] = false
                    end
                end
            end
        end
        menu.keybind_open = nil
        set_modeselect(false, 20, 20, 1)
        menu.dropbox_open = nil
        set_dropboxthingy(false, 400, 200, 160, 1, {"q","q","q"})
        menu.colorpicker_open = nil
        set_tooltip(nil, nil, nil, false)
        set_colorpicker(false, {255,0,0}, nil, false, "", 400, 200)
    end

    function menu:toggle_fade()
        if not menu.ready or menu.fading or menu.unloaded then return end
        if menu.open then close_transient_ui() end
        menu.fading = true
        menu.fadestart = tick()
    end

    function menu:InputBeganMenu(key)
        -- RightShift: only closes transients (menu fade is now handled by the Menu Toggle)
        if key.KeyCode == Enum.KeyCode.RightShift and not loadingthing.Visible then
            if menu.open and not menu.fading then
                close_transient_ui()
            end
        end

        if menu == nil then return end

        if menu.textboxopen then
            if key.KeyCode == Enum.KeyCode.RightShift or key.KeyCode == Enum.KeyCode.Return then
                for _, v in pairs(menu.options) do
                    for _, v1 in pairs(v) do
                        for _, v2 in pairs(v1) do
                            if v2[2] == "textbox" and v2[5] then
                                v2[5] = false
                                v2[4].Color = RGB(255,255,255)
                                menu.textboxopen = false
                                v2[4].Text = v2[1]
                                if v2.callback then v2.callback(v2[1]) end
                            end
                        end
                    end
                end
            end
        end

        if menu.open and not menu.fading then
            for _, v in pairs(menu.options) do
                for _, v1 in pairs(v) do
                    for _, v2 in pairs(v1) do
                        if v2[2] == "toggle" and v2[5] ~= nil then
                            if v2[5][2] == "keybind" and v2[5][5] and key.KeyCode.Value ~= 0 then
                                v2[5][4][2].Color = RGB(30,30,30)
                                v2[5][4][1].Text = KeyEnumToName(key.KeyCode)
                                v2[5][1] = (KeyEnumToName(key.KeyCode) == "None") and nil or key.KeyCode
                                v2[5][5] = false
                            end
                        elseif v2[2] == "textbox" and v2[5] then
                            if not INPUT_SERVICE:IsKeyDown(Enum.KeyCode.LeftControl) then
                                if string.len(v2[1]) <= 28 then
                                    if table.find(textBoxLetters, KeyEnumToName(key.KeyCode)) then
                                        if INPUT_SERVICE:IsKeyDown(Enum.KeyCode.LeftShift) then
                                            v2[1] ..= string.upper(KeyEnumToName(key.KeyCode))
                                        else
                                            v2[1] ..= string.lower(KeyEnumToName(key.KeyCode))
                                        end
                                    elseif KeyEnumToName(key.KeyCode) == "Space" then
                                        v2[1] ..= " "
                                    elseif keymodifiernames[KeyEnumToName(key.KeyCode)] ~= nil then
                                        if INPUT_SERVICE:IsKeyDown(Enum.KeyCode.LeftShift) then
                                            v2[1] ..= KeyModifierToName(KeyEnumToName(key.KeyCode), v2[6])
                                        else
                                            v2[1] ..= KeyEnumToName(key.KeyCode)
                                        end
                                    elseif KeyEnumToName(key.KeyCode) == "Back" and v2[1] ~= "" then
                                        v2[1] = string.sub(v2[1], 0, #v2[1] - 1)
                                    end
                                end
                                v2[4].Text = v2[1] .. "|"
                            end
                        end
                    end
                end
            end
        end
    end

    function menu:InputBeganKeybinds(key)
        if INPUT_SERVICE:GetFocusedTextBox() or menu.textboxopen then return end
        for i = 1, #self.keybinds do
            local value = self.keybinds[i][1]
            if key.KeyCode == value[5][1] then
                value[5].lastvalue = value[5].relvalue
                if value[5].toggletype == 2 then value[5].relvalue = not value[5].relvalue
                elseif value[5].toggletype == 1 then value[5].relvalue = true
                elseif value[5].toggletype == 3 then value[5].relvalue = false end
            elseif value[5].toggletype == 4 then
                value[5].relvalue = true
            end
            if value[5].lastvalue ~= value[5].relvalue then
                value[5].event:fire(value[5].relvalue)
            end
        end
    end

    function menu:InputEndedKeybinds(key)
        for i = 1, #self.keybinds do
            local value = self.keybinds[i][1]
            value[5].lastvalue = value[5].relvalue
            if key.KeyCode == value[5][1] then
                if value[5].toggletype == 1 then value[5].relvalue = false
                elseif value[5].toggletype == 3 then value[5].relvalue = true end
            end
            if value[5].lastvalue ~= value[5].relvalue then
                value[5].event:fire(value[5].relvalue)
            end
        end
    end

