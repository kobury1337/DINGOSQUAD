	local function CreateTab(name)
		local tabFrame = window.TabFrame:Clone()
		tabFrame.Name = name .. "TabFrame"
		tabFrame.Visible = false
		tabFrame.Parent = window.MainFrame

		-- Create tab button
		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.Size = UDim2.new(0, 86, 0, 24)
		btn.BackgroundTransparency = 1
		btn.TextColor3 = Color3.fromRGB(255,255,255)
		btn.Text = name
		btn.TextSize = 16
		btn.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
		btn.Parent = window.TabList

		-- Reposition all tab buttons (insert before config)
		local children = {}
		for _, child in ipairs(window.TabList:GetChildren()) do
			if child:IsA("TextButton") then
				table.insert(children, child)
			end
		end
		table.sort(children, function(a,b)
			return a.Position.Y.Scale < b.Position.Y.Scale
		end)
		local y = 0.03482
		for i, child in ipairs(children) do
			if child.Name == "config" then
				child.Position = UDim2.new(0, 0, 0.85687)
			else
				child.Position = UDim2.new(0, 0, y)
				y = y + 0.03482
			end
		end

		-- Click to show tab
		btn.MouseButton1Click:Connect(function()
			-- Hide all frames
			window.ConfigFrame.Visible = false
			for _, tab in ipairs(window.Tabs) do
				tab.Frame.Visible = false
			end
			-- Show this tab
			tabFrame.Visible = true
			window.CurrentTab = tabObj
			-- Highlight button
			for _, b in ipairs(window.TabList:GetChildren()) do
				if b:IsA("TextButton") then
					b.TextColor3 = Color3.fromRGB(255,255,255)
				end
			end
			btn.TextColor3 = window.ActivationColor
		end)

		-- Tab object with methods
		local tabObj = {
			Name = name,
			Frame = tabFrame,
			Button = btn,
			Controls = {},
			ControlsCount = 0, -- for positioning
		}

		-- ============================================================
