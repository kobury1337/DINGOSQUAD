		Name = "Frame",
		Visible = false,
		BackgroundColor3 = CONST.Controls.Dropdown.OptionsFrame.Background,
		Size = CONST.Controls.Dropdown.OptionsFrame.Size,
		Position = UDim2.new(0, 0, 1, 0),
		BorderColor3 = CONST.Controls.Dropdown.OptionsFrame.BorderColor,
	})

	-- State
	local options = opts.Options or {}
	local selected = opts.Default or (options[1] or "")
	local controlId = "dropdown_" .. self._name .. "_" .. opts.Name
	controlCounter = controlCounter + 1
	local id = controlId .. "_" .. tostring(controlCounter)

	local function updateDropdown(newVal)
		selected = newVal
		dropdownBtn.Text = selected
		if opts.Callback then opts.Callback(selected) end
		Library.Controls[id] = {
			type = "Dropdown",
			value = selected,
			options = options,
			name = opts.Name,
			tab = self._name,
		}
	end

	-- Populate options
	local function refreshOptions()
		for _, child in ipairs(optionsFrame:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		for i, opt in ipairs(options) do
			local btn = createInstance("TextButton", optionsFrame, {
				Name = "Option" .. i,
				Size = CONST.Controls.Dropdown.OptionsFrame.ButtonSize,
				Position = UDim2.new(0, 0, (i-1) * 0.30952, 0),
				BackgroundTransparency = CONST.Controls.Dropdown.OptionsFrame.ButtonBackgroundTransparency,
				Text = opt,
				TextSize = CONST.Controls.Dropdown.OptionsFrame.ButtonTextSize,
				TextColor3 = CONST.Controls.Dropdown.OptionsFrame.ButtonColor,
				FontFace = CONST.Controls.Dropdown.OptionsFrame.ButtonFont,
				BorderSizePixel = 0,
			})
			btn.MouseButton1Click:Connect(function()
				updateDropdown(opt)
				optionsFrame.Visible = false
			end)
		end
	end
	refreshOptions()

	-- Toggle dropdown
	dropdownBtn.MouseButton1Click:Connect(function()
		optionsFrame.Visible = not optionsFrame.Visible
		-- Close other dropdowns
		for _, d in ipairs(openDropdowns) do
			if d ~= optionsFrame then d.Visible = false end
		end
		table.insert(openDropdowns, optionsFrame)
	end)

	-- Initial value
	updateDropdown(selected)

	self._controls[id] = { type = "Dropdown", value = selected }
	return dropdownBtn
end

