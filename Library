-- Helper: Generate unique ID
local function GenerateControlId()
	ControlIdCounter = ControlIdCounter + 1
	return "control_" .. tostring(ControlIdCounter)
end

-- Helper: Get user input service key name
local function GetKeyName(keyCode)
	if keyCode == Enum.KeyCode.Unknown then return "?" end
	local name = tostring(keyCode):gsub("Enum.KeyCode.", "")
	return name
end

-- Helper: Write/read config files (using executor's environment)
local function WriteConfigFile(name, data)
	local path = CONFIG_FOLDER .. name .. CONFIG_EXTENSION
	local json = HttpService:JSONEncode(data)
	if writefile then
		writefile(path, json)
		return true
	else
		warn("writefile not available – config cannot be saved")
		return false
	end
end

local function ReadConfigFile(name)
	local path = CONFIG_FOLDER .. name .. CONFIG_EXTENSION
	if readfile then
		local success, data = pcall(readfile, path)
		if success and data then
			local decoded = HttpService:JSONDecode(data)
			return decoded
		end
	end
	return nil
end

local function ListConfigFiles()
	local files = {}
	if listfiles then
		local all = listfiles(CONFIG_FOLDER)
		for _, file in ipairs(all) do
			if file:match(CONFIG_EXTENSION .. "$") then
				local name = file:match("([^/]+)" .. CONFIG_EXTENSION .. "$")
				if name then table.insert(files, name) end
			end
		end
	end
	return files
end

