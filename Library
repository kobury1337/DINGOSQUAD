function Tab:CreateToggle(opts)
	opts = opts or {}
	local toggleBtn = createInstance("TextButton", self._frame, {
		Name = "ToggleButton",
		Size = CONST.Controls.Toggle.Size,
		Position = UDim2.new(0.05833, 0, 0.03482 + #self._controls * 0.06, 0),
		BackgroundColor3 = CONST.Controls.Toggle.Background,
		BorderColor3 = CONST.Controls.Toggle.BorderColor,
		Text = "",
		TextSize = 14,
	})
	createUIAspectRatioConstraint(toggleBtn)

	local title = createInstance("TextLabel", toggleBtn, {
		Name = "Title",
		Text = opts.Name or "Toggle",
		TextSize = CONST.Controls.Toggle.TitleTextSize,
		TextColor3 = CONST.Controls.Toggle.TitleColor,
		FontFace = CONST.Controls.Toggle.TitleFont,
		BackgroundTransparency = 1,
		Size = CONST.Controls.Toggle.TitleSize,
		Position = UDim2.new(3.45455, 0, -0.09091, 0),
		BorderSizePixel = 0,
	})

	local bindBtn = createInstance("TextButton", toggleBtn, {
		Name = "Bind",
		Size = CONST.Controls.Toggle.BindSize,
		Position = UDim2.new(10.81818, 0, -0.09091, 0),
		BackgroundTransparency = 1,
		Text = "[-]",
		TextSize = CONST.Controls.Toggle.BindTextSize,
		TextColor3 = CONST.Controls.Toggle.BindColor,
		FontFace = CONST.Controls.Toggle.BindFont,
		BorderSizePixel = 0,
	})

	local colorPickerBtn = createInstance("TextButton", toggleBtn, {
		Name = "ColorPicker",
		Size = CONST.Controls.Toggle.ColorPickerSize,
		Position = UDim2.new(16.36364, 0, -0.36364, 0),
		BackgroundColor3 = activationColor, -- will be updated
		BorderColor3 = Color3.fromRGB(0,0,0),
		Text = "",
		TextSize = 14,
		BorderSizePixel = 0,
	})

	-- State
	local state = {
		value = opts.Default or false,
		keybind = nil, -- Enum.KeyCode or nil
		mode = "TOGGLE", -- "ALWAYS", "TOGGLE", "HOLD"
	}
	local controlId = "toggle_" .. self._name .. "_" .. opts.Name
	controlCounter = controlCounter + 1
	local id = controlId .. "_" .. tostring(controlCounter)

	-- Update toggle appearance
	local function updateToggle()
		toggleBtn.BackgroundColor3 = state.value and activationColor or CONST.Controls.Toggle.Background
		if opts.Callback then opts.Callback(state.value) end
		-- Update registry
		Library.Controls[id] = {
			type = "Toggle",
			value = state.value,
			keybind = state.keybind,
			mode = state.mode,
			name = opts.Name,
			tab = self._name,
		}
		updateKeybindDisplay()
	end

	-- Toggle click
	toggleBtn.MouseButton1Click:Connect(function()
		state.value = not state.value
		updateToggle()
	end)

	-- Keybind logic
	local function handleKeybind(input)
		if state.mode == "ALWAYS" then
			state.value = true
			updateToggle()
		elseif state.mode == "TOGGLE" then
			if input.KeyCode == state.keybind then
				state.value = not state.value
				updateToggle()
			end
		elseif state.mode == "HOLD" then
			if input.KeyCode == state.keybind then
				state.value = true
				updateToggle()
			end
		end
	end

	local function handleKeyRelease(input)
		if state.mode == "HOLD" and input.KeyCode == state.keybind then
			state.value = false
			updateToggle()
		end
	end

	-- Bind button: listening for key
	local listening = false
	bindBtn.MouseButton1Click:Connect(function()
		if not listening then
			listening = true
			bindBtn.Text = "[...]"
			-- Wait for a key
			local connection
			connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if gameProcessed then return end
				if input.KeyCode ~= Enum.KeyCode.Unknown then
					state.keybind = input.KeyCode
					bindBtn.Text = "[" .. input.KeyCode.Name .. "]"
					listening = false
					connection:Disconnect()
					updateToggle()
				end
			end)
		end
	end)

	-- Right-click bind button -> show BindOptions
	local bindOptionsFrame = createInstance("Frame", bindBtn, {
		Name = "BindOptions",
		Visible = false,
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(19, 19, 19),
		Size = UDim2.new(0, 88, 0, 77),
		Position = UDim2.new(0.80328, 0, 0.07692, 0),
		BorderColor3 = Color3.fromRGB(0,0,0),
	})
	local function createBindOption(text, modeValue, yPos)
		local btn = createInstance("TextButton", bindOptionsFrame, {
			Name = text,
			Size = UDim2.new(0, 61, 0, 13),
			Position = UDim2.new(0.14391, 0, yPos, 0),
			BackgroundTransparency = 1,
			Text = text,
			TextSize = 14,
			TextColor3 = Color3.fromRGB(255,255,255),
			FontFace = CONST.TabButton.Font,
			BorderSizePixel = 0,
		})
		btn.MouseButton1Click:Connect(function()
			state.mode = modeValue
			bindOptionsFrame.Visible = false
			updateToggle()
		end)
	end
	createBindOption("ALWAYS", "ALWAYS", 0.06401)
	createBindOption("TOGGLE", "TOGGLE", 0.41466)
	createBindOption("HOLD", "HOLD", 0.7783)

	bindBtn.MouseButton2Click:Connect(function()
		bindOptionsFrame.Visible = not bindOptionsFrame.Visible
	end)

	-- ColorPicker button opens color picker
	colorPickerBtn.MouseButton1Click:Connect(function()
		local color = state.value and activationColor or Color3.fromRGB(255,255,255)
		openColorPicker(colorPickerBtn, function(newColor)
			-- Update color picker button background
			colorPickerBtn.BackgroundColor3 = newColor
			-- Maybe store color in state? For toggle, we might want to store the color as a property.
			-- But spec only says toggles have activation color. We'll store it in registry.
			Library.Controls[id].color = newColor
			-- Also update the toggle's activation color? The toggle uses activationColor globally.
			-- But we might allow per-toggle color. We can store a custom color.
			-- We'll store it and when toggle updates, we set background to that color if value true.
			-- Override updateToggle to use state.color if set.
			state.color = newColor
			updateToggle()
		end)
	end)

	-- Store state
	self._controls[id] = state
	Library.Controls[id] = {
		type = "Toggle",
		value = state.value,
		keybind = state.keybind,
		mode = state.mode,
		name = opts.Name,
		tab = self._name,
		color = activationColor,
	}

	-- Initial update
	updateToggle()

	-- Input handling for keybinds
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if state.keybind and input.KeyCode == state.keybind then
			if state.mode == "TOGGLE" then
				state.value = not state.value
				updateToggle()
			elseif state.mode == "ALWAYS" then
				state.value = true
				updateToggle()
			elseif state.mode == "HOLD" then
				state.value = true
				updateToggle()
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if state.keybind and input.KeyCode == state.keybind and state.mode == "HOLD" then
			state.value = false
			updateToggle()
		end
	end)

	return toggleBtn
end

function Tab:CreateSlider(opts)
	opts = opts or {}
	local bar = createInstance("TextButton", self._frame, {
		Name = "Bar",
		Size = CONST.Controls.Slider.Size,
		Position = UDim2.new(0.05833, 0, 0.03482 + #self._controls * 0.06, 0),
		BackgroundColor3 = CONST.Controls.Slider.Background,
		BorderColor3 = CONST.Controls.Slider.BorderColor,
		Text = "",
		TextSize = 13,
	})

	local title = createInstance("TextLabel", bar, {
		Name = "Title",
		Text = opts.Name or "Slider",
		TextSize = CONST.Controls.Slider.TitleTextSize,
		TextColor3 = CONST.Controls.Slider.TitleColor,
		FontFace = CONST.Controls.Slider.TitleFont,
		BackgroundTransparency = 1,
		Size = CONST.Controls.Slider.TitleSize,
		Position = UDim2.new(0.08181, 0, -3.77792, 0),
		BorderSizePixel = 0,
	})

	-- Fill frame
	local fill = createInstance("Frame", bar, {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = activationColor,
		BorderSizePixel = 0,
	})

	-- State
	local min = opts.Min or 0
	local max = opts.Max or 100
	local value = opts.Default or 50
	value = clamp(value, min, max)

	local controlId = "slider_" .. self._name .. "_" .. opts.Name
	controlCounter = controlCounter + 1
	local id = controlId .. "_" .. tostring(controlCounter)

	local function updateSlider(newVal)
		value = clamp(newVal, min, max)
		local percent = (value - min) / (max - min)
		fill.Size = UDim2.new(percent, 0, 1, 0)
		if opts.Callback then opts.Callback(value) end
		Library.Controls[id] = {
			type = "Slider",
			value = value,
			min = min,
			max = max,
			name = opts.Name,
			tab = self._name,
		}
	end

	updateSlider(value)

	-- Click/drag to set value
	local draggingSlider = false
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingSlider = true
			local relX = input.Position.X - bar.AbsolutePosition.X
			local percent = clamp(relX / bar.AbsoluteSize.X, 0, 1)
			local newVal = min + percent * (max - min)
			updateSlider(newVal)
		end
	end)
	bar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingSlider = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
			local relX = input.Position.X - bar.AbsolutePosition.X
			local percent = clamp(relX / bar.AbsoluteSize.X, 0, 1)
			local newVal = min + percent * (max - min)
			updateSlider(newVal)
		end
	end)

	-- Store
	self._controls[id] = { type = "Slider", value = value }
	return bar
end

