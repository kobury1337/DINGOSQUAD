    local function LoadConfig(loaded)
        local lines = {}
        for s in loaded:gmatch("[^\r\n]+") do table.insert(lines, s) end

        local function section(name)
            local s, e
            for i, v in next, lines do if v == name then s = i break end end
            for i, v in next, lines do if s and i > s and v == "}" then e = i break end end
            return s, e
        end

        if lines[1] == "DINGOSQUAD-UI v1" then
            local s, e = section("toggles {")
            if s and e then for i = 1, e - s - 1 do
                local tt = string.split(lines[i+s], "|")
                if menu.options[tt[1]] and menu.options[tt[1]][tt[2]] and menu.options[tt[1]][tt[2]][tt[3]] then
                    menu.options[tt[1]][tt[2]][tt[3]][1] = (tt[4] == "true")
                end
            end end

            s, e = section("sliders {")
            if s and e then for i = 1, e - s - 1 do
                local tt = string.split(lines[i+s], "|")
                if menu.options[tt[1]] and menu.options[tt[1]][tt[2]] and menu.options[tt[1]][tt[2]][tt[3]] then
                    menu.options[tt[1]][tt[2]][tt[3]][1] = tonumber(tt[4])
                end
            end end

            s, e = section("dropboxs {")
