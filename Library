local function finalize(window)
    local tabs = {}
    for _, tab in ipairs(window._tabs) do
        local tabtable = { name = tab._name, content = {} }
        for _, group in ipairs(tab._groups) do
            local g = { name = group.name, autopos = group.side, content = {} }
            if group.fill then g.autofill = true end
            if group.size then g.size = group.size end
            for _, el in ipairs(group.elements) do
                table.insert(g.content, el)
            end
            table.insert(tabtable.content, g)
        end
        table.insert(tabs, tabtable)
    end

    -- Always append the required Settings tab
    table.insert(tabs, build_settings_tab())

    menu.title = window._title
    menu.game  = window._game
    menu.Initialize(tabs)

    -- Watermark
    local wm = menu.watermark
    wm.textString = " | user | " .. os.date("%b. %d, %Y")
    wm.pos = Vector2.new(50, 9)
    wm.text = {}
    local fulltext = menu.title .. wm.textString
    wm.width = #fulltext * 7 + 10
    wm.height = 19
    wm.rect = {}
    Draw:FilledRect(false, wm.pos.x, wm.pos.y+1, wm.width, 2,
        {menu.mc[1]-40, menu.mc[2]-40, menu.mc[3]-40, 255}, wm.rect)
    Draw:FilledRect(false, wm.pos.x, wm.pos.y, wm.width, 2,
        {menu.mc[1], menu.mc[2], menu.mc[3], 255}, wm.rect)
    Draw:FilledRect(false, wm.pos.x, wm.pos.y+3, wm.width, wm.height-5, {50,50,50,255}, wm.rect)
    for i = 0, wm.height-4 do
        Draw:FilledRect(false, wm.pos.x, wm.pos.y+3+i, wm.width, 1,
            {50-i*1.7, 50-i*1.7, 50-i*1.7, 255}, wm.rect)
    end
    Draw:OutlinedRect(false, wm.pos.x, wm.pos.y, wm.width, wm.height, {0,0,0,255}, wm.rect)
    Draw:OutlinedRect(false, wm.pos.x-1, wm.pos.y-1, wm.width+2, wm.height+2, {0,0,0,100}, wm.rect)
    Draw:OutlinedText(fulltext, 2, false, wm.pos.x+5, wm.pos.y+3, 13, false,
        {255,255,255,255}, {0,0,0,255}, wm.text)
    for _, v in pairs(menu.watermark.rect) do v.Visible = true end
    menu.watermark.text[1].Visible = true

    -- Config textbox init
    if menu.options["Settings"] and menu.options["Settings"]["Configuration"] then
        local tb = menu.options["Settings"]["Configuration"]["ConfigName"]
        local rel = GetConfigs()
        if rel[menu.options["Settings"]["Configuration"]["Configs"][1]] then
            tb[1] = rel[menu.options["Settings"]["Configuration"]["Configs"][1]]
            tb[4].Text = tb[1]
        end
    end

    loadingthing.Visible = false
    menu.ready = true
    if not menu.open then
        menu.fading = true
        menu.fadestart = tick()
    end
    CreateNotification("UI loaded.")
    CreateNotification("Press Delete to open / close.")
end

function Library:CreateWindow(config)
    config = config or {}
    local window = {
        _title = config.Title or "UI Library",
        _game  = config.Game or "uni",
        _tabs  = {},
    }
    function window:CreateTab(name)
        local tab = { _name = name, _groups = {} }
        table.insert(self._tabs, tab)
        return setmetatable(tab, { __index = TabMT })
    end
    if config.Build then config.Build(window) end
    task.defer(function() finalize(window) end)
    return window
end

function Library:GetMenu() return menu end
function Library:GetOption(tab, group, name)
    if menu and menu.GetVal then return menu:GetVal(tab, group, name) end
end
function Library:Unload() if menu and menu.unload then menu:unload() end end

return Library
