local function CreateTabFrame(Window, Tab)
    local TabFrame = Create("Frame", {
        Name = "TabFrame_" .. Tab.ID,

        Visible = false,

        BackgroundColor3 = COLORS.SecondaryBackground,

        BorderSizePixel = 1,
        BorderColor3 = COLORS.Border,

        Size = UDim2.new(0, 480, 0, 517),
        Position = UDim2.new(0, 0, 0, 0),

        Parent = Window.ContentContainer,
    })

    Tab.Frame = TabFrame

    ------------------------------------------------------------
    -- CONTROLS CONTAINER
    ------------------------------------------------------------

    local ControlsContainer = Create("Frame", {
        Name = "Controls",

        BackgroundTransparency = 1,

        Size = UDim2.new(1, 0, 1, -35),
        Position = UDim2.new(0, 0, 0, 0),

        Parent = TabFrame,
    })

    Tab.ControlsContainer = ControlsContainer

    return TabFrame
end

----------------------------------------------------------------
-- CONTROL BASE
----------------------------------------------------------------

local function RegisterControl(Window, Tab, Control)
    Window.NextControlID += 1

    Control.ID = Window.NextControlID
    Control.Destroyed = false

    Window.Controls[Control.ID] = Control
    Tab.Controls[Control.ID] = Control

    return Control
end

----------------------------------------------------------------
-- BUTTON
----------------------------------------------------------------

local function CreateButton(Tab, Settings)
    Settings = Settings or {}

    assert(
        type(Settings.Name) == "string" and Settings.Name ~= "",
        "DINGOSQUAD: Button name must be a non-empty string"
    )

    assert(
        Settings.Callback == nil or type(Settings.Callback) == "function",
        "DINGOSQUAD: Button callback must be a function"
    )

    local Window = Tab.Window

    local Button = {
        Name = Settings.Name,
        Type = "Button",

        Callback = Settings.Callback or function() end,

        Connections = {},
    }

    RegisterControl(Window, Tab, Button)

    ------------------------------------------------------------
    -- POSITION
    ------------------------------------------------------------

    local Index = #Tab.ControlOrder + 1

    local YOffset = 10 + ((Index - 1) * 34)

    ------------------------------------------------------------
    -- UI
    ------------------------------------------------------------

    local ButtonFrame = Create("TextButton", {
        Name = "Button_" .. Button.ID,

        AutoButtonColor = false,

        BackgroundColor3 = COLORS.ControlBackground,

        BorderSizePixel = 1,
        BorderColor3 = COLORS.ControlBorder,

        Size = UDim2.new(0, 126, 0, 17),
        Position = UDim2.new(0, 28, 0, YOffset),

        Text = Settings.Name,

        TextColor3 = COLORS.Text,
        TextSize = 13,

        TextXAlignment = Enum.TextXAlignment.Left,

        Font = FONTS.Main,

        Parent = Tab.ControlsContainer,
    })

    Button.Frame = ButtonFrame

    ------------------------------------------------------------
    -- CLICK
    ------------------------------------------------------------

    Button.Connections[#Button.Connections + 1] =
        ButtonFrame.MouseButton1Click:Connect(function()
            if Button.Destroyed then
                return
            end

            local Success, ErrorMessage =
                pcall(Button.Callback)

            if not Success then
                warn(
                    "[DINGOSQUAD] Button callback error:",
                    ErrorMessage
                )
            end
        end)

    ------------------------------------------------------------
    -- DESTROY
    ------------------------------------------------------------

    function Button:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        DisconnectAll(self.Connections)

        if self.Frame then
            self.Frame:Destroy()
        end

        Window.Controls[self.ID] = nil
        Tab.Controls[self.ID] = nil
    end

    table.insert(Tab.ControlOrder, Button)

    return Button
end

local function CreateToggle(Tab, Settings)
    Settings = Settings or {}

    assert(
        type(Settings.Name) == "string" and Settings.Name ~= "",
        "DINGOSQUAD: Toggle name must be a non-empty string"
    )

    assert(
        Settings.Callback == nil or type(Settings.Callback) == "function",
        "DINGOSQUAD: Toggle callback must be a function"
    )

    local Window = Tab.Window

    local Toggle = {
        Name = Settings.Name,
        Type = "Toggle",

        Value = Settings.Default == true,

        Callback = Settings.Callback or function() end,

        Keybind = nil,
        KeybindMode = "TOGGLE",

        Connections = {},
    }

    RegisterControl(Window, Tab, Toggle)

    ------------------------------------------------------------
    -- POSITION
    ------------------------------------------------------------

    local Index = #Tab.ControlOrder + 1

    local YOffset = 10 + ((Index - 1) * 34)

    ------------------------------------------------------------
    -- CONTAINER
    ------------------------------------------------------------

    local Container = Create("Frame", {
        Name = "Toggle_" .. Toggle.ID,

        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 0, YOffset),

        Parent = Tab.ControlsContainer,
    })

    Toggle.Frame = Container

    ------------------------------------------------------------
    -- TOGGLE BUTTON
    ------------------------------------------------------------

    local ToggleButton = Create("TextButton", {
        Name = "ToggleButton",

        AutoButtonColor = false,

        BackgroundColor3 = COLORS.ToggleOff,

        BorderSizePixel = 1,
        BorderColor3 = COLORS.ControlBorder,

        Size = UDim2.new(0, 11, 0, 18),
        Position = UDim2.new(0, 28, 0, 0),

        Text = "",

        Parent = Container,
    })

    Toggle.ToggleButton = ToggleButton

    ------------------------------------------------------------
    -- TITLE
    ------------------------------------------------------------

    local Title = Create("TextLabel", {
        Name = "Title",

        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        Size = UDim2.new(0, 120, 0, 18),
        Position = UDim2.new(0, 45, 0, 0),

        Text = Settings.Name,

        TextColor3 = COLORS.Text,
        TextSize = 14,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,

        Font = FONTS.Main,

        Parent = Container,
    })

    Toggle.Title = Title

    ------------------------------------------------------------
    -- KEYBIND DISPLAY
    ------------------------------------------------------------

    local Bind = Create("TextButton", {
        Name = "Bind",

        AutoButtonColor = false,

        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        Size = UDim2.new(0, 45, 0, 18),
        Position = UDim2.new(0, 170, 0, 0),

        Text = "[-]",

        TextColor3 = COLORS.Text,
        TextSize = 13,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,

        Font = FONTS.Main,

        Parent = Container,
    })

    Toggle.BindButton = Bind

    ------------------------------------------------------------
    -- VISUAL
    ------------------------------------------------------------

    local function UpdateVisual()
        if Toggle.Value then
            ToggleButton.BackgroundColor3 =
                Window.ActivationColor
        else
            ToggleButton.BackgroundColor3 =
                COLORS.ToggleOff
        end
    end

    UpdateVisual()

    ------------------------------------------------------------
    -- CALLBACK
    ------------------------------------------------------------

    local function FireCallback()
        local Success, ErrorMessage =
            pcall(Toggle.Callback, Toggle.Value)

        if not Success then
            warn(
                "[DINGOSQUAD] Toggle callback error:",
                ErrorMessage
            )
        end
    end

    ------------------------------------------------------------
    -- SET VALUE
    ------------------------------------------------------------

    function Toggle:SetValue(Value, Fire)
        if self.Destroyed then
            return
        end

        self.Value = Value == true

        UpdateVisual()

        if Fire ~= false then
            FireCallback()
        end
    end

    ------------------------------------------------------------
    -- GET VALUE
    ------------------------------------------------------------

    function Toggle:GetValue()
        return self.Value
    end

    ------------------------------------------------------------
    -- KEYBIND FOUNDATION
    ------------------------------------------------------------

    function Toggle:SetKeybind(Key, Mode)
        self.Keybind = Key
        self.KeybindMode = Mode or "TOGGLE"

        if Key then
            Bind.Text =
                "[" .. Key.Name .. "]"
        else
            Bind.Text = "[-]"
        end
    end

    function Toggle:GetKeybind()
        return self.Keybind, self.KeybindMode
    end

    ------------------------------------------------------------
    -- CLICK
    ------------------------------------------------------------

    Toggle.Connections[#Toggle.Connections + 1] =
        ToggleButton.MouseButton1Click:Connect(function()
            Toggle:SetValue(
                not Toggle.Value
            )
        end)

    ------------------------------------------------------------
    -- DESTROY
    ------------------------------------------------------------

    function Toggle:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        DisconnectAll(self.Connections)

        if self.Frame then
            self.Frame:Destroy()
        end

        Window.Controls[self.ID] = nil
        Tab.Controls[self.ID] = nil
    end

    table.insert(Tab.ControlOrder, Toggle)

    return Toggle
end

----------------------------------------------------------------
-- TAB OBJECT
----------------------------------------------------------------

local function CreateTabObject(Window, Name)
    Window.NextTabID += 1

    local Tab = {
        ID = Window.NextTabID,

        Name = Name,

        Window = Window,

        Frame = nil,
        Button = nil,

        Controls = {},
        ControlOrder = {},

        Connections = {},
        Destroyed = false,
    }

    return Tab
end

----------------------------------------------------------------
-- WINDOW OBJECT
----------------------------------------------------------------

local function CreateWindowObject(Settings)
    Settings = Settings or {}

    local Window = {
        Name = Settings.Name or "DINGOSQUAD",

        ActivationColor =
            Settings.ActivationColor
            or DEFAULT_ACTIVATION_COLOR,

        Tabs = {},

        Controls = {},

        State = {
            Tabs = {},
            Controls = {},
        },

        Connections = {},

        Destroyed = false,

        ActiveTab = nil,

        NextTabID = 0,
        NextControlID = 0,
    }

    ------------------------------------------------------------
    -- UI
    ------------------------------------------------------------

    CreateWindowUI(Window)

    ------------------------------------------------------------
    -- SELECT TAB
    ------------------------------------------------------------

    function Window:SelectTab(Tab)
        if self.Destroyed then
            return
        end

        if self.ActiveTab then
            self.ActiveTab.Frame.Visible = false

            if self.ActiveTab.Button then
                self.ActiveTab.Button.TextColor3 =
                    COLORS.Text
            end
        end

        self.ActiveTab = Tab

        if Tab then
            Tab.Frame.Visible = true

            if Tab.Button then
                Tab.Button.TextColor3 =
                    self.ActivationColor
            end
        end
    end

    ------------------------------------------------------------
    -- CREATE TAB
    ------------------------------------------------------------

    function Window:CreateTab(Name)
        assert(
            type(Name) == "string" and Name ~= "",
            "DINGOSQUAD: Tab name must be a non-empty string"
        )

        for _, ExistingTab in ipairs(self.Tabs) do
            if ExistingTab.Name == Name then
                error(
                    "DINGOSQUAD: A tab named '" ..
                    Name ..
                    "' already exists"
                )
            end
        end

        local Tab =
            CreateTabObject(self, Name)

        CreateTabFrame(self, Tab)

        --------------------------------------------------------
        -- TAB BUTTON
        --------------------------------------------------------

        local TabButton = Create("TextButton", {
            Name = "Tab_" .. Tab.ID,

            AutoButtonColor = false,

            BackgroundTransparency = 1,

            BorderSizePixel = 0,

            Size = UDim2.new(0, 86, 0, 24),

            Text = Name,

            TextColor3 = COLORS.Text,
            TextSize = 16,

            Font = FONTS.Main,

            Parent = self.DynamicTabContainer,
        })

        Tab.Button = TabButton

        Tab.Connections[#Tab.Connections + 1] =
            TabButton.MouseButton1Click:Connect(function()
                self:SelectTab(Tab)
            end)

        table.insert(self.Tabs, Tab)

        self.State.Tabs[Tab.ID] = {
            Name = Tab.Name,
        }

        if #self.Tabs == 1 then
            self:SelectTab(Tab)
        end

        return Tab
    end

    ------------------------------------------------------------
    -- GET TAB
    ------------------------------------------------------------

    function Window:GetTab(Name)
        for _, Tab in ipairs(self.Tabs) do
            if Tab.Name == Name then
                return Tab
            end
        end

        return nil
    end

    ------------------------------------------------------------
    -- ACTIVATION COLOR
    ------------------------------------------------------------

    function Window:SetActivationColor(Color)
        assert(
            typeof(Color) == "Color3",
            "DINGOSQUAD: ActivationColor must be a Color3"
        )

        self.ActivationColor = Color

        if self.ActiveTab and self.ActiveTab.Button then
            self.ActiveTab.Button.TextColor3 = Color
        end

        for _, Control in pairs(self.Controls) do
            if Control.Type == "Toggle"
                and Control.Frame
                and Control.Value then

                Control.Frame.BackgroundColor3 = Color
            end
        end
    end

    ------------------------------------------------------------
    -- TAB COUNT
    ------------------------------------------------------------

    function Window:GetTabCount()
        return #self.Tabs
    end

    ------------------------------------------------------------
    -- DESTROY TAB
    ------------------------------------------------------------

    function Window:DestroyTab(Tab)
        if not Tab or Tab.Destroyed then
            return
        end

        Tab.Destroyed = true

        for _, Control in pairs(Tab.Controls) do
            Control:Destroy()
        end

        DisconnectAll(Tab.Connections)

        if Tab.Button then
            Tab.Button:Destroy()
        end

        if Tab.Frame then
            Tab.Frame:Destroy()
        end

        self.State.Tabs[Tab.ID] = nil

        for Index, ExistingTab in ipairs(self.Tabs) do
            if ExistingTab == Tab then
                table.remove(self.Tabs, Index)
                break
            end
        end

        if self.ActiveTab == Tab then
            self.ActiveTab = nil

            if self.Tabs[1] then
                self:SelectTab(self.Tabs[1])
            end
        end
    end

    ------------------------------------------------------------
    -- STATE
    ------------------------------------------------------------

    function Window:GetState()
        return self.State
    end

    ------------------------------------------------------------
    -- DESTROY WINDOW
    ------------------------------------------------------------

    function Window:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, Tab in ipairs(self.Tabs) do
            Tab.Destroyed = true
            DisconnectAll(Tab.Connections)
        end

        DisconnectAll(self.Connections)

        if self.ScreenGui then
            self.ScreenGui:Destroy()
        end

        table.clear(self.Tabs)
        table.clear(self.Controls)
        table.clear(self.State.Tabs)
        table.clear(self.State.Controls)
    end

    return Window
end

----------------------------------------------------------------
-- TAB CONTROL API
----------------------------------------------------------------

local function AttachTabAPI(Tab)
    function Tab:CreateButton(Settings)
        return CreateButton(self, Settings)
    end

    function Tab:CreateToggle(Settings)
        return CreateToggle(self, Settings)
    end

    return Tab
end

----------------------------------------------------------------
-- LIBRARY API
----------------------------------------------------------------

function Library:CreateWindow(Settings)
    local Window = CreateWindowObject(Settings)

    table.insert(self.Windows, Window)

    return Window
end

function Library:GetWindows()
    return self.Windows
end

function Library:DestroyAll()
    for _, Window in ipairs(self.Windows) do
        Window:Destroy()
    end

    table.clear(self.Windows)
end

----------------------------------------------------------------
-- TAB API PATCH
----------------------------------------------------------------

-- CreateTab is wrapped so every returned Tab receives
-- CreateButton/CreateToggle.

local OriginalCreateWindow = Library.CreateWindow

function Library:CreateWindow(Settings)
    local Window = OriginalCreateWindow(self, Settings)

    local OriginalCreateTab = Window.CreateTab

    function Window:CreateTab(Name)
        local Tab = OriginalCreateTab(self, Name)

        AttachTabAPI(Tab)

        return Tab
    end

    return Window
end

----------------------------------------------------------------
-- RETURN
----------------------------------------------------------------

return Library
