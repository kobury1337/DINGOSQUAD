	local function UpdateKeybindsDisplay()
		local listFrame = window.KeybindListFrame
		-- Clear children except UIListLayout
		for _, child in ipairs(listFrame:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local count = 0
		for id, control in pairs(Controls) do
			if control.Type == "Toggle" and control.Keybind then
				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(0, 160, 0, 16) -- will be auto-sized
				label.BackgroundTransparency = 1
				label.TextColor3 = Color3.fromRGB(255,255,255)
				local keyName = GetKeyName(control.Keybind)
				local mode = control.Mode or "TOGGLE"
				local displayName = control.Title or "Toggle"
				label.Text = displayName .. " - " .. keyName .. " [" .. mode .. "]"
				label.TextSize = 12
				label.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
				label.TextXAlignment = Enum.TextXAlignment.Left
				label.Parent = listFrame
				count = count + 1
			end
		end

		-- Resize frames to fit
		local totalHeight = 16 * count + 10 -- padding
		if totalHeight < 10 then totalHeight = 10 end
		listFrame.Size = UDim2.new(0, 160, 0, totalHeight)
		window.KeybindsFrame.Size = UDim2.new(0, 202, 0, totalHeight + 50) -- title + padding
