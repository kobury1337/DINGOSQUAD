-- --------------------------------------------------------------------------
-- Color Picker
-- --------------------------------------------------------------------------
local function openColorPicker(sourceButton, callback)
	-- Create a color picker frame if not exists
	local picker = Instance.findFirstChild("ColorPickerFrame")
	if picker then picker:Destroy() end

	local screenGui = windowInstance.Parent
	local pickerFrame = createInstance("Frame", screenGui, {
		Name = "ColorPickerFrame",
		Size = UDim2.new(0, 300, 0, 350),
		Position = UDim2.new(0.5, -150, 0.3, 0),
		BackgroundColor3 = Color3.fromRGB(20,20,20),
		BorderSizePixel = 2,
		BorderColor3 = Color3.fromRGB(60,60,60),
	})
	createUIStroke(pickerFrame, 2, Color3.fromRGB(80,80,80))

	-- Color wheel (horizontal gradient)
	local colorWheel = createInstance("ImageLabel", pickerFrame, {
		Size = UDim2.new(0.9, 0, 0.4, 0),
		Position = UDim2.new(0.05, 0, 0.05, 0),
		BackgroundColor3 = Color3.fromRGB(255,255,255),
		Image = "rbxasset://textures/ui/Gradient.png", -- We'll use a gradient image
		ScaleType = Enum.ScaleType.Fit,
	})
	-- But we need a gradient that spans hue. We'll use a UIGradient.
	local grad = Instance.new("UIGradient")
	grad.Rotation = 0
	grad.Offset = Vector2.new(0,0)
	grad.Transparency = NumberSequence.new(0)
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
		ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255,255,0)),
		ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0,255,0)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
		ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0,0,255)),
		ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255,0,255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
	})
	grad.Parent = colorWheel

	-- Brightness bar (vertical)
	local brightnessBar = createInstance("ImageLabel", pickerFrame, {
		Size = UDim2.new(0.05, 0, 0.4, 0),
		Position = UDim2.new(0.9, 0, 0.05, 0),
		BackgroundColor3 = Color3.fromRGB(255,255,255),
		Image = "rbxasset://textures/ui/Gradient.png",
		ScaleType = Enum.ScaleType.Fit,
	})
	local bGrad = Instance.new("UIGradient")
	bGrad.Rotation = 270 -- vertical
	bGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,0,0)), -- we'll update this dynamically
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0)),
	})
	bGrad.Parent = brightnessBar

	-- RGB inputs
	local rgbFrame = createInstance("Frame", pickerFrame, {
		Size = UDim2.new(0.9, 0, 0.2, 0),
		Position = UDim2.new(0.05, 0, 0.5, 0),
		BackgroundTransparency = 1,
	})
	local function createRGBBox(label, x)
		local lbl = createInstance("TextLabel", rgbFrame, {
			Text = label,
			TextSize = 14,
			TextColor3 = Color3.fromRGB(255,255,255),
			BackgroundTransparency = 1,
			Size = UDim2.new(0.1, 0, 0.4, 0),
			Position = UDim2.new(x, 0, 0.1, 0),
		})
		local box = createInstance("TextBox", rgbFrame, {
			Size = UDim2.new(0.15, 0, 0.6, 0),
			Position = UDim2.new(x + 0.12, 0, 0.1, 0),
			BackgroundColor3 = Color3.fromRGB(50,50,50),
			BorderColor3 = Color3.fromRGB(40,40,40),
			Text = "255",
			TextSize = 14,
			TextColor3 = Color3.fromRGB(255,255,255),
			FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json"),
		})
		return box
	end
	local rBox = createRGBBox("R", 0)
	local gBox = createRGBBox("G", 0.35)
	local bBox = createRGBBox("B", 0.7)

	-- Preview color
	local preview = createInstance("Frame", pickerFrame, {
		Size = UDim2.new(0.3, 0, 0.15, 0),
		Position = UDim2.new(0.05, 0, 0.75, 0),
		BackgroundColor3 = Color3.fromRGB(255,255,255),
		BorderSizePixel = 1,
		BorderColor3 = Color3.fromRGB(40,40,40),
	})

	-- Cancel/Apply buttons
	local cancelBtn = createInstance("TextButton", pickerFrame, {
		Size = UDim2.new(0.2, 0, 0.12, 0),
		Position = UDim2.new(0.25, 0, 0.85, 0),
		Text = "Cancel",
		TextSize = 14,
		TextColor3 = Color3.fromRGB(255,255,255),
		BackgroundColor3 = Color3.fromRGB(60,60,60),
		BorderColor3 = Color3.fromRGB(40,40,40),
	})
	local applyBtn = createInstance("TextButton", pickerFrame, {
		Size = UDim2.new(0.2, 0, 0.12, 0),
		Position = UDim2.new(0.55, 0, 0.85, 0),
		Text = "Apply",
		TextSize = 14,
		TextColor3 = Color3.fromRGB(255,255,255),
		BackgroundColor3 = Color3.fromRGB(60,60,60),
		BorderColor3 = Color3.fromRGB(40,40,40),
	})

	-- Current color state
	local currentColor = sourceButton.BackgroundColor3 or Color3.fromRGB(255,255,255)
	local function updateUIFromColor(color)
		preview.BackgroundColor3 = color
		rBox.Text = tostring(math.round(color.R * 255))
		gBox.Text = tostring(math.round(color.G * 255))
		bBox.Text = tostring(math.round(color.B * 255))
		-- Update brightness bar gradient middle to color
		local grad = brightnessBar:FindFirstChildOfClass("UIGradient")
		if grad then
			local midColor = color
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
				ColorSequenceKeypoint.new(0.5, midColor),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0)),
			})
		end
	end
	updateUIFromColor(currentColor)

	-- Mouse events on color wheel
	local pickingHue = false
	colorWheel.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			pickingHue = true
			local pos = input.Position - colorWheel.AbsolutePosition
			local x = clamp(pos.X / colorWheel.AbsoluteSize.X, 0, 1)
			-- Get color from gradient at x
			local hue = x
			-- We'll convert hue to RGB (simplified)
			local r, g, b = Color3.fromHSV(hue, 1, 1):GetComponents()
			local color = Color3.fromRGB(r*255, g*255, b*255)
			currentColor = color
			updateUIFromColor(color)
		end
	end)
	colorWheel.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			pickingHue = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if pickingHue and input.UserInputType == Enum.UserInputType.MouseMovement then
			local pos = input.Position - colorWheel.AbsolutePosition
			local x = clamp(pos.X / colorWheel.AbsoluteSize.X, 0, 1)
			local hue = x
			local r, g, b = Color3.fromHSV(hue, 1, 1):GetComponents()
			local color = Color3.fromRGB(r*255, g*255, b*255)
			currentColor = color
			updateUIFromColor(color)
		end
	end)

	-- Brightness bar
	local pickingBrightness = false
	brightnessBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			pickingBrightness = true
			local pos = input.Position - brightnessBar.AbsolutePosition
			local y = clamp(pos.Y / brightnessBar.AbsoluteSize.Y, 0, 1)
			-- Adjust brightness of currentColor
			local h, s, v = currentColor:ToHSV()
			v = 1 - y
			local newColor = Color3.fromHSV(h, s, v)
			currentColor = newColor
			updateUIFromColor(newColor)
		end
	end)
	brightnessBar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			pickingBrightness = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if pickingBrightness and input.UserInputType == Enum.UserInputType.MouseMovement then
			local pos = input.Position - brightnessBar.AbsolutePosition
			local y = clamp(pos.Y / brightnessBar.AbsoluteSize.Y, 0, 1)
			local h, s, v = currentColor:ToHSV()
			v = 1 - y
			local newColor = Color3.fromHSV(h, s, v)
			currentColor = newColor
			updateUIFromColor(newColor)
		end
	end)

	-- RGB textboxes
	local function onRGBChanged()
		local r = tonumber(rBox.Text) or 0
		local g = tonumber(gBox.Text) or 0
		local b = tonumber(bBox.Text) or 0
		r = clamp(r, 0, 255)
		g = clamp(g, 0, 255)
		b = clamp(b, 0, 255)
		local color = Color3.fromRGB(r, g, b)
		currentColor = color
		updateUIFromColor(color)
	end
	rBox:GetPropertyChangedSignal("Text"):Connect(onRGBChanged)
	gBox:GetPropertyChangedSignal("Text"):Connect(onRGBChanged)
	bBox:GetPropertyChangedSignal("Text"):Connect(onRGBChanged)

	-- Apply / Cancel
	applyBtn.MouseButton1Click:Connect(function()
		callback(currentColor)
		pickerFrame:Destroy()
	end)
	cancelBtn.MouseButton1Click:Connect(function()
		pickerFrame:Destroy()
	end)

	-- Close if clicking outside
	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local mousePos = input.Position
			if not pickerFrame.AbsolutePosition then return end
			local absPos = pickerFrame.AbsolutePosition
			local absSize = pickerFrame.AbsoluteSize
			if mousePos.X < absPos.X or mousePos.X > absPos.X + absSize.X or
			   mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + absSize.Y then
				-- Clicked outside, do nothing? We can cancel? Better to not auto-close.
			end
		end
	end)
end

-- --------------------------------------------------------------------------
-- Keybind display update
-- --------------------------------------------------------------------------
local function updateKeybindDisplay()
	-- Clear existing labels
	for _, child in ipairs(Library._keybindFrame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	-- Collect all controls with keybinds
	local keybinds = {}
	for id, data in pairs(Library.Controls) do
		if data.type == "Toggle" and data.keybind then
			table.insert(keybinds, data)
		end
	end
	-- Sort by name
	table.sort(keybinds, function(a,b) return a.name < b.name end)
	-- Create labels
	local yOffset = 0
	for _, data in ipairs(keybinds) do
		local label = createInstance("TextLabel", Library._keybindFrame, {
			Name = "KeybindLabel",
			Text = data.name .. " - " .. (data.keybind and data.keybind.Name or "?") .. " [" .. data.mode .. "]",
			TextSize = 12,
			TextColor3 = Color3.fromRGB(255,255,255),
			FontFace = CONST.TabButton.Font,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 13),
			Position = UDim2.new(0, 0, 0.19754 + yOffset * 0.1, 0),
			BorderSizePixel = 0,
		})
		yOffset = yOffset + 1
	end
	-- Resize keybind frame height based on count
	local newHeight = math.max(CONST.Keybinds.Frame.Size.Y.Scale, 0.1 + yOffset * 0.1)
	Library._keybindFrame.Size = UDim2.new(CONST.Keybinds.Frame.Size.X.Scale, 0, newHeight, 0)
end

-- --------------------------------------------------------------------------
-- Serialization / Deserialization for configs
-- --------------------------------------------------------------------------
function Library:SerializeAllControls()
	local data = {
		Controls = {},
		Tabs = {},
	}
	for id, ctrl in pairs(Library.Controls) do
		local serial = {}
		if ctrl.type == "Toggle" then
			serial.type = "Toggle"
			serial.value = ctrl.value
			serial.keybind = ctrl.keybind and ctrl.keybind.Name
			serial.mode = ctrl.mode
			serial.color = ctrl.color and { ctrl.color.R, ctrl.color.G, ctrl.color.B } or nil
		elseif ctrl.type == "Slider" then
			serial.type = "Slider"
			serial.value = ctrl.value
			serial.min = ctrl.min
			serial.max = ctrl.max
		elseif ctrl.type == "Dropdown" then
			serial.type = "Dropdown"
			serial.value = ctrl.value
			serial.options = ctrl.options
		elseif ctrl.type == "ColorPicker" then
			serial.type = "ColorPicker"
			serial.value = { ctrl.value.R, ctrl.value.G, ctrl.value.B }
		else
			serial.type = "Unknown"
		end
		data.Controls[id] = serial
	end
	-- Also store tab order? We can store tab names.
	for name, _ in pairs(tabButtons) do
		table.insert(data.Tabs, name)
	end
	return data
end

function Library:DeserializeAllControls(data)
	if not data or not data.Controls then return end
	for id, serial in pairs(data.Controls) do
		local ctrl = Library.Controls[id]
		if ctrl then
			if serial.type == "Toggle" then
				ctrl.value = serial.value
				if serial.keybind then
					ctrl.keybind = Enum.KeyCode[serial.keybind] or nil
				end
				ctrl.mode = serial.mode or "TOGGLE"
				if serial.color then
					ctrl.color = Color3.fromRGB(serial.color[1]*255, serial.color[2]*255, serial.color[3]*255)
				end
				-- Need to update the UI instance
				-- We stored the toggle button in the control data? We'll need to reference it.
				-- In our implementation, we stored the toggle state in self._controls of the tab.
				-- But we also need to update the visual.
				-- We'll store a reference to the toggle button when creating.
				-- For simplicity, we can loop through all tabs and find the control.
				-- But we can also store the button instance in the control data.
				-- Let's modify creation to store the button in Library.Controls[id].instance
				-- I'll do that in the toggle creation: add instance = toggleBtn.
				if ctrl.instance then
					local btn = ctrl.instance
					btn.BackgroundColor3 = ctrl.value and (ctrl.color or activationColor) or CONST.Controls.Toggle.Background
				end
			elseif serial.type == "Slider" then
				ctrl.value = serial.value
				-- Update slider fill
				if ctrl.instance then
					local bar = ctrl.instance
					local fill = bar:FindFirstChild("Fill")
					if fill then
						local percent = (serial.value - (ctrl.min or 0)) / ((ctrl.max or 100) - (ctrl.min or 0))
						fill.Size = UDim2.new(percent, 0, 1, 0)
					end
				end
			elseif serial.type == "Dropdown" then
				ctrl.value = serial.value
				if ctrl.instance then
					local btn = ctrl.instance
					btn.Text = serial.value
				end
			elseif serial.type == "ColorPicker" then
				local color = Color3.fromRGB(serial.value[1]*255, serial.value[2]*255, serial.value[3]*255)
				ctrl.value = color
				if ctrl.instance then
					ctrl.instance.BackgroundColor3 = color
				end
			end
		end
	end
	-- Update keybind display
	updateKeybindDisplay()
end

