    function Draw:Keybind(key, x, y, t)
        local tbl = {}
        Draw:MenuFilledRect(true, x, y, 44, 16, {25,25,25,255}, t)
        Draw:MenuBigText(KeyEnumToName(key), true, true, x+22, y+1, t)
        table.insert(tbl, t[#t])
        Draw:MenuOutlinedRect(true, x, y, 44, 16, {30,30,30,255}, t)
        table.insert(tbl, t[#t])
        Draw:MenuOutlinedRect(true, x+1, y+1, 42, 14, {0,0,0,255}, t)
