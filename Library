local function CreateButton(Tab, Settings)
    Settings = Settings or {}
    assert(type(Settings.Name) == "string" and Settings.Name ~= "", "DINGOSQUAD: Button name must be a non-empty string")
    assert(Settings.Callback == nil or type(Settings.Callback) == "function", "DINGOSQUAD: Button callback must be a function")
    local Window = Tab.Window
    local Button = {Name = Settings.Name, Type = "Button", Callback = Settings.Callback or function() end, Connections = {}}
    RegisterControl(Window, Tab, Button)
    local Index = #Tab.ControlOrder + 1
    local YOffset = 10 + ((Index - 1) * 34)
    local ButtonFrame = Create("TextButton", {
        Name = "Button_" .. Button.ID, AutoButtonColor = false,
        BackgroundColor3 = COLORS.ControlBackground, BorderSizePixel = 1, BorderColor3 = COLORS.ControlBorder,
        Size = UDim2.new(0, 126, 0, 17), Position = UDim2.new(0, 28, 0, YOffset),
        Text = Settings.Name, TextColor3 = COLORS.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        Font = FONTS.Main, Parent = Tab.ControlsContainer,
    })
    Button.Frame = ButtonFrame
    Button.Connections[#Button.Connections + 1] = ButtonFrame.MouseButton1Click:Connect(function()
        if Button.Destroyed then return end
        local Success, ErrorMessage = pcall(Button.Callback)
        if not Success then warn("[DINGOSQUAD] Button callback error:", ErrorMessage) end
    end)
    function Button:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true
        DisconnectAll(self.Connections)
        if self.Frame then self.Frame:Destroy() end
        Window.Controls[self.ID] = nil
        Tab.Controls[self.ID] = nil
    end
    table.insert(Tab.ControlOrder, Button)
    return Button
end

