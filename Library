local function RebuildKeybinds(W)
    if not W.KeybindFrame or W.Destroyed then return end
    for _,Child in ipairs(W.KeybindFrame:GetChildren())do if Child:IsA("GuiObject") then Child:Destroy() end end
    local binds={}
    for _,Control in pairs(W.Controls)do if not Control.Destroyed and Control.Type=="Toggle" and Control.Keybind then table.insert(binds,Control) end end
    table.sort(binds,function(A,B)return A.ID<B.ID end)
    local rows=math.max(1,#binds)
    local rowHeight=18
    local height=24+(rows*rowHeight)
    W.Keybinds.Size=UDim2.new(0,202,0,math.max(100,height))
    W.KeybindFrame.Size=UDim2.new(0,160,0,height-32)
    for I,B in ipairs(binds)do
        local Row=Create("Frame",{Name="Keybind_"..B.ID,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(1,0,0,rowHeight),Position=UDim2.new(0,0,0,(I-1)*rowHeight),Parent=W.KeybindFrame})
        Create("TextLabel",{Name="Name",BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(0,91,1,0),Position=UDim2.new(0,5,0,0),Text=B.Name,TextColor3=COLORS.Text,TextSize=13,Font=FONTS.Main,TextXAlignment=Enum.TextXAlignment.Left,Parent=Row})
