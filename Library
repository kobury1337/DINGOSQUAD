		gBox.Text = tostring(math.floor(g))
		bBox.Text = tostring(math.floor(b))

		local function UpdatePreview()
			preview.BackgroundColor3 = selectedColor
			rBox.Text = tostring(math.floor(selectedColor.R*255))
			gBox.Text = tostring(math.floor(selectedColor.G*255))
			bBox.Text = tostring(math.floor(selectedColor.B*255))
		end

		-- Click on gradient to pick color
		gradientFrame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local pos = input.Position - gradientFrame.AbsolutePosition
				local x = math.clamp(pos.X / gradientFrame.AbsoluteSize.X, 0, 1)
				local y = math.clamp(pos.Y / gradientFrame.AbsoluteSize.Y, 0, 1)
				local hue = x
				local sat = 1 - y
				local color = Color3.fromHSV(hue, sat, 1)
				selectedColor = color
				UpdatePreview()
			end
		end)

		-- Brightness slider (drag)
		local brightDragging = false
		brightnessFrame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				brightDragging = true
			end
		end)
		brightnessFrame.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				brightDragging = false
			end
		end)
		brightnessFrame.MouseMoved:Connect(function(input)
			if brightDragging then
				local pos = input.Position.Y - brightnessFrame.AbsolutePosition.Y
				local height = brightnessFrame.AbsoluteSize.Y
				local bright = 1 - math.clamp(pos / height, 0, 1)
				local h, s, v = selectedColor:ToHSV()
				selectedColor = Color3.fromHSV(h, s, bright)
				UpdatePreview()
			end
		end)

		-- RGB text boxes
		local function OnRGBChanged(box, channel)
			local val = tonumber(box.Text)
			if val then
				val = math.clamp(math.round(val), 0, 255)
				box.Text = tostring(val)
				if channel == 1 then r = val
				elseif channel == 2 then g = val
				elseif channel == 3 then b = val end
				selectedColor = Color3.fromRGB(r, g, b)
				UpdatePreview()
			end
		end
		rBox.FocusLost:Connect(function() OnRGBChanged(rBox, 1) end)
		gBox.FocusLost:Connect(function() OnRGBChanged(gBox, 2) end)
		bBox.FocusLost:Connect(function() OnRGBChanged(bBox, 3) end)

		-- Cancel
		cancelBtn.MouseButton1Click:Connect(function()
			popup:Destroy()
			ColorPickerOpen = nil
		end)

		-- Apply
		applyBtn.MouseButton1Click:Connect(function()
			callback(selectedColor)
			popup:Destroy()
			ColorPickerOpen = nil
		end)

		ColorPickerOpen = popup
	end

	-- ============================================================
	--  Build config frame and toggle
	-- ============================================================

	BuildConfigFrame()
	BuildConfigKeybindsToggle()

	-- ============================================================
	--  Window API
	-- ============================================================

	window.CreateTab = CreateTab

	return window
end

-- ============================================================
--  UserInputService key listening (global)
-- ============================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode ~= Enum.KeyCode.Unknown then
		-- If we have a keybind listener active
		if ActiveKeybindListener then
			ActiveKeybindListener(input.KeyCode)
			ActiveKeybindListener = nil
			return
		end
		-- Check for keybind triggers
		for id, control in pairs(Controls) do
			if control.Type == "Toggle" and control.Keybind then
				if input.KeyCode == control.Keybind then
					if control.Mode == "ALWAYS" then
						-- do nothing (always on)
					elseif control.Mode == "TOGGLE" then
						control.Active = not control.Active
						control.UpdateAppearance()
					elseif control.Mode == "HOLD" then
						control.Active = true
						control.UpdateAppearance()
					end
				end
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode ~= Enum.KeyCode.Unknown then
		for id, control in pairs(Controls) do
			if control.Type == "Toggle" and control.Keybind and control.Mode == "HOLD" then
				if input.KeyCode == control.Keybind then
					control.Active = false
					control.UpdateAppearance()
				end
			end
		end
	end
end)

-- Close dropdowns on click outside
UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if ActiveDropdown then
			local mousePos = input.Position
			local frame = ActiveDropdown
			local absPos = frame.AbsolutePosition
			local size = frame.AbsoluteSize
			if mousePos.X < absPos.X or mousePos.X > absPos.X + size.X or
			   mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + size.Y then
				frame.Visible = false
				ActiveDropdown = nil
			end
		end
		if KeybindOptionsOpen then
			local mousePos = input.Position
			local frame = KeybindOptionsOpen
			local absPos = frame.AbsolutePosition
			local size = frame.AbsoluteSize
			if mousePos.X < absPos.X or mousePos.X > absPos.X + size.X or
			   mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + size.Y then
				frame.Visible = false
				KeybindOptionsOpen = nil
			end
		end
	end
end)

