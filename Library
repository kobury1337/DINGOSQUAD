    end
end
local function UpdateKeybindDisplays(W)for _,B in pairs(W.Controls)do if B.Type=="Toggle" and B.KeybindDisplay and B.Keybind then B.KeybindDisplay.TextColor3=B.Value and W.ActivationColor or COLORS.Text end end end

