function DingoSquadUI:CreateWindow(params)
	if Window then return Window end -- only one window allowed
	local activationColor = params.ActivationColor or DEFAULT_ACTIVATION_COLOR
	Window = BuildUI()
	Window.ActivationColor = activationColor
	return Window
end

