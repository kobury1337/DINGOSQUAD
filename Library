do
    function Draw:UnRender()
        for _, v in pairs(allrender) do
            for _, v1 in pairs(v) do
                if v1 and type(v1) ~= "number" and v1.__OBJECT_EXISTS then v1:Remove() end
            end
        end
    end
    function Draw:OutlinedRect(visible, x, y, w, h, clr, t)
        local s = Drawing.new("Square")
        s.Visible = visible; s.Position = Vector2.new(x, y); s.Size = Vector2.new(w, h)
        s.Color = RGB(clr[1], clr[2], clr[3]); s.Filled = false; s.Thickness = 0
        s.Transparency = clr[4] / 255
        table.insert(t, s)
        if not table.find(allrender, t) then table.insert(allrender, t) end
    end
    function Draw:FilledRect(visible, x, y, w, h, clr, t)
        local s = Drawing.new("Square")
        s.Visible = visible; s.Position = Vector2.new(x, y); s.Size = Vector2.new(w, h)
        s.Color = RGB(clr[1], clr[2], clr[3]); s.Filled = true; s.Thickness = 0
        s.Transparency = clr[4] / 255
        table.insert(t, s)
        if not table.find(allrender, t) then table.insert(allrender, t) end
    end
    function Draw:Line(visible, thickness, sx, sy, ex, ey, clr, t)
        local s = Drawing.new("Line")
        s.Visible = visible; s.Thickness = thickness
        s.From = Vector2.new(sx, sy); s.To = Vector2.new(ex, ey)
        s.Color = RGB(clr[1], clr[2], clr[3]); s.Transparency = clr[4] / 255
        table.insert(t, s)
        if not table.find(allrender, t) then table.insert(allrender, t) end
    end
