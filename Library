local function CreateSlider(Tab, Settings)
    Settings = Settings or {}
    assert(type(Settings.Name) == "string" and Settings.Name ~= "", "DINGOSQUAD: Slider name must be a non-empty string")
    assert(type(Settings.Min) == "number", "DINGOSQUAD: Slider Min must be a number")
    assert(type(Settings.Max) == "number" and Settings.Max > Settings.Min, "DINGOSQUAD: Slider Max must be greater than Min")
    assert(Settings.Default == nil or type(Settings.Default) == "number", "DINGOSQUAD: Slider Default must be a number")
    assert(Settings.Increment == nil or (type(Settings.Increment) == "number" and Settings.Increment > 0), "DINGOSQUAD: Slider Increment must be greater than 0")
    assert(Settings.Callback == nil or type(Settings.Callback) == "function", "DINGOSQUAD: Slider callback must be a function")

    local Window = Tab.Window
    local Min = Settings.Min
    local Max = Settings.Max
    local Increment = Settings.Increment or 1
    local Default = Settings.Default
    if Default == nil then Default = Min end

    local Slider = {
        Name = Settings.Name,
        Type = "Slider",
        Min = Min,
        Max = Max,
        Increment = Increment,
        Value = Default,
        Callback = Settings.Callback or function() end,
        Connections = {},
    }
    RegisterControl(Window, Tab, Slider)

    local Index = #Tab.ControlOrder + 1
    local YOffset = 10 + ((Index - 1) * 34)

    local Container = Create("Frame", {
        Name = "Slider_" .. Slider.ID,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 180, 0, 28),
        Position = UDim2.new(0, 28, 0, YOffset),
        Parent = Tab.ControlsContainer,
    })
    Slider.Frame = Container

    local Title = Create("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 120, 0, 13),
        Position = UDim2.new(0, 0, 0, 0),
        Text = Settings.Name,
        TextColor3 = COLORS.Text,
        TextSize = 14,
        Font = FONTS.Main,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Parent = Container,
    })
    Slider.Title = Title

    local ValueLabel = Create("TextLabel", {
        Name = "Value",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 55, 0, 13),
        Position = UDim2.new(0, 125, 0, 0),
        Text = "",
        TextColor3 = COLORS.Text,
        TextSize = 13,
        Font = FONTS.Main,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Center,
        Parent = Container,
    })
    Slider.ValueLabel = ValueLabel

    local Track = Create("TextButton", {
        Name = "Track",
        AutoButtonColor = false,
        BackgroundColor3 = COLORS.SliderBackground,
        BorderSizePixel = 1,
        BorderColor3 = COLORS.ControlBorder,
        Size = UDim2.new(0, 180, 0, 8),
        Position = UDim2.new(0, 0, 0, 17),
        Text = "",
        Parent = Container,
    })
    Slider.Track = Track

    local Fill = Create("Frame", {
        Name = "Fill",
        BackgroundColor3 = Window.ActivationColor,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        Parent = Track,
    })
    Slider.Fill = Fill

    local Knob = Create("Frame", {
        Name = "Knob",
        BackgroundColor3 = Window.ActivationColor,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 5, 1, 4),
        Position = UDim2.new(0, -2, 0, -2),
        Parent = Track,
    })
    Slider.Knob = Knob

    local Dragging = false

    local function RoundToIncrement(Value)
        local Steps = math.floor(((Value - Min) / Increment) + 0.5)
        return Min + (Steps * Increment)
    end

    local function ClampValue(Value)
        return math.clamp(RoundToIncrement(Value), Min, Max)
    end

    local function FormatValue(Value)
        if Value % 1 == 0 then
            return tostring(math.floor(Value))
        end
        return string.format("%.3f", Value):gsub("0+$", ""):gsub("%.$", "")
    end

    local function UpdateVisual()
        local Alpha = math.clamp((Slider.Value - Min) / (Max - Min), 0, 1)
        Fill.Size = UDim2.new(Alpha, 0, 1, 0)
        Knob.Position = UDim2.new(Alpha, -2, 0, -2)
        Fill.BackgroundColor3 = Window.ActivationColor
        Knob.BackgroundColor3 = Window.ActivationColor
        ValueLabel.Text = FormatValue(Slider.Value)
    end

    local function FireCallback()
        local Success, ErrorMessage = pcall(Slider.Callback, Slider.Value)
        if not Success then warn("[DINGOSQUAD] Slider callback error:", ErrorMessage) end
    end

    function Slider:SetValue(Value, Fire)
        if self.Destroyed then return end
        assert(type(Value) == "number", "DINGOSQUAD: Slider value must be a number")
        self.Value = ClampValue(Value)
        UpdateVisual()
        if Fire ~= false then FireCallback() end
    end

    function Slider:GetValue()
        return self.Value
    end

    local function UpdateFromInput(Input)
        local X = Input.Position.X
        local Left = Track.AbsolutePosition.X
        local Width = Track.AbsoluteSize.X
        local Alpha = math.clamp((X - Left) / math.max(Width, 1), 0, 1)
        Slider:SetValue(Min + ((Max - Min) * Alpha))
    end

    Slider.Connections[#Slider.Connections + 1] = Track.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            UpdateFromInput(Input)
        end
    end)

    Slider.Connections[#Slider.Connections + 1] = UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then return end
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            UpdateFromInput(Input)
        end
    end)

    Slider.Connections[#Slider.Connections + 1] = UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)

    Slider:SetValue(Default, false)

    function Slider:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true
        Dragging = false
        DisconnectAll(self.Connections)
        if self.Frame then self.Frame:Destroy() end
        Window.Controls[self.ID] = nil
        Tab.Controls[self.ID] = nil
    end

    table.insert(Tab.ControlOrder, Slider)
    return Slider
end

local function CreateTabObject(Window, Name)
    Window.NextTabID += 1
    return {ID = Window.NextTabID, Name = Name, Window = Window, Frame = nil, Button = nil, Controls = {}, ControlOrder = {}, Connections = {}, Destroyed = false}
end

local function AddTabAPI(Tab)
    function Tab:CreateButton(Settings) return CreateButton(self, Settings) end
    function Tab:CreateToggle(Settings) return CreateToggle(self, Settings) end
    function Tab:CreateSlider(Settings) return CreateSlider(self, Settings) end
    return Tab
end

local function CreateWindowObject(Settings)
    Settings = Settings or {}
    local Window = {
        Name = Settings.Name or "DINGOSQUAD", ActivationColor = Settings.ActivationColor or DEFAULT_ACTIVATION_COLOR,
        Tabs = {}, Controls = {}, State = {Tabs = {}, Controls = {}}, Connections = {}, Destroyed = false,
        ActiveTab = nil, NextTabID = 0, NextControlID = 0,
    }
    CreateWindowUI(Window)

    function Window:SelectTab(Tab)
        if self.Destroyed or not Tab or Tab.Destroyed then return end
        if self.ActiveTab then
            if self.ActiveTab.Frame then self.ActiveTab.Frame.Visible = false end
            if self.ActiveTab.Button then self.ActiveTab.Button.TextColor3 = COLORS.Text end
        end
        self.ActiveTab = Tab
        Tab.Frame.Visible = true
        Tab.Button.TextColor3 = self.ActivationColor
    end

    function Window:CreateTab(Name)
        assert(type(Name) == "string" and Name ~= "", "DINGOSQUAD: Tab name must be a non-empty string")
        for _, ExistingTab in ipairs(self.Tabs) do
            if ExistingTab.Name == Name then error("DINGOSQUAD: A tab named '" .. Name .. "' already exists") end
        end
        local Tab = AddTabAPI(CreateTabObject(self, Name))
        CreateTabFrame(self, Tab)
        local TabButton = Create("TextButton", {
            Name = "Tab_" .. Tab.ID, AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(0, 86, 0, 24), Text = Name, TextColor3 = COLORS.Text, TextSize = 16,
            Font = FONTS.Main, Parent = self.DynamicTabContainer,
        })
        Tab.Button = TabButton
        Tab.Connections[#Tab.Connections + 1] = TabButton.MouseButton1Click:Connect(function() self:SelectTab(Tab) end)
        table.insert(self.Tabs, Tab)
        self.State.Tabs[Tab.ID] = {Name = Tab.Name}
        if #self.Tabs == 1 then self:SelectTab(Tab) end
        return Tab
    end

    function Window:GetTab(Name)
        for _, Tab in ipairs(self.Tabs) do if Tab.Name == Name then return Tab end end
        return nil
    end

    function Window:SetActivationColor(Color)
        assert(typeof(Color) == "Color3", "DINGOSQUAD: ActivationColor must be a Color3")
        self.ActivationColor = Color
        if self.ActiveTab and self.ActiveTab.Button then self.ActiveTab.Button.TextColor3 = Color end
        for _, Control in pairs(self.Controls) do
            if Control.Type == "Toggle" and Control.ToggleButton and Control.Value then
                Control.ToggleButton.BackgroundColor3 = Color
            elseif Control.Type == "Slider" and Control.Fill and Control.Knob then
                Control.Fill.BackgroundColor3 = Color
                Control.Knob.BackgroundColor3 = Color
            end
        end
    end

    function Window:GetTabCount() return #self.Tabs end

    function Window:DestroyTab(Tab)
        if not Tab or Tab.Destroyed then return end
        local Controls = {}
        for _, Control in pairs(Tab.Controls) do table.insert(Controls, Control) end
        for _, Control in ipairs(Controls) do Control:Destroy() end
        Tab.Destroyed = true
        DisconnectAll(Tab.Connections)
        if Tab.Button then Tab.Button:Destroy() end
        if Tab.Frame then Tab.Frame:Destroy() end
        self.State.Tabs[Tab.ID] = nil
        for Index, ExistingTab in ipairs(self.Tabs) do
            if ExistingTab == Tab then table.remove(self.Tabs, Index) break end
        end
        if self.ActiveTab == Tab then
            self.ActiveTab = nil
            if self.Tabs[1] then self:SelectTab(self.Tabs[1]) end
        end
    end

    function Window:GetState() return self.State end

    function Window:Destroy()
        if self.Destroyed then return end
        local Tabs = table.clone(self.Tabs)
        self.Destroyed = true
        for _, Tab in ipairs(Tabs) do
            local Controls = {}
            for _, Control in pairs(Tab.Controls) do table.insert(Controls, Control) end
            for _, Control in ipairs(Controls) do Control:Destroy() end
            DisconnectAll(Tab.Connections)
        end
        DisconnectAll(self.Connections)
        if self.ScreenGui then self.ScreenGui:Destroy() end
        table.clear(self.Tabs)
        table.clear(self.Controls)
        table.clear(self.State.Tabs)
        table.clear(self.State.Controls)
    end

    return Window
end

function Library:CreateWindow(Settings)
    local Window = CreateWindowObject(Settings)
    table.insert(self.Windows, Window)
    return Window
end

function Library:GetWindows() return self.Windows end

function Library:DestroyAll()
    local Windows = table.clone(self.Windows)
    for _, Window in ipairs(Windows) do Window:Destroy() end
    table.clear(self.Windows)
end

return Library