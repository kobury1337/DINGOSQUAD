	-- Populate dropdown with existing configs
	local function refreshConfigDropdown()
		-- Clear old options
		for _, child in ipairs(optionsFrame:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local configs = listConfigs()
		for i, name in ipairs(configs) do
			local btn = createInstance("TextButton", optionsFrame, {
				Name = "ConfigOption",
				Size = CONST.Controls.Dropdown.OptionsFrame.ButtonSize,
				Position = UDim2.new(0, 0, (i-1) * 0.30952, 0),
				BackgroundTransparency = CONST.Controls.Dropdown.OptionsFrame.ButtonBackgroundTransparency,
				Text = name,
				TextSize = CONST.Controls.Dropdown.OptionsFrame.ButtonTextSize,
				TextColor3 = CONST.Controls.Dropdown.OptionsFrame.ButtonColor,
				FontFace = CONST.Controls.Dropdown.OptionsFrame.ButtonFont,
				BorderSizePixel = 0,
			})
			btn.MouseButton1Click:Connect(function()
				dropdownBtn.Text = name
				optionsFrame.Visible = false
				-- Store selected config name
				Library._selectedConfig = name
				textBox.Text = name
			end)
		end
	end

	-- Dropdown toggle
	dropdownBtn.MouseButton1Click:Connect(function()
		refreshConfigDropdown()
		optionsFrame.Visible = not optionsFrame.Visible
		-- Close other dropdowns
		for _, d in ipairs(openDropdowns) do
			if d ~= optionsFrame then d.Visible = false end
		end
		table.insert(openDropdowns, optionsFrame)
	end)

	-- Save button
	saveBtn.MouseButton1Click:Connect(function()
		local name = textBox.Text
		if name == "" then return end
		local data = Library:SerializeAllControls()
		data.Name = name
		if saveConfig(name, data) then
			refreshConfigDropdown()
			dropdownBtn.Text = name
			Library._selectedConfig = name
		end
	end)

	-- Override button
	overrideBtn.MouseButton1Click:Connect(function()
		local selected = Library._selectedConfig
		if not selected then return end
		local newName = textBox.Text
		local data = Library:SerializeAllControls()
		if newName ~= "" and newName ~= selected then
			-- Rename: save new, delete old
			data.Name = newName
			saveConfig(newName, data)
			-- Delete old
			local oldPath = CONFIG_FOLDER .. selected .. ".ds"
			if isfile(oldPath) then
				pcall(delfile, oldPath)
			end
			Library._selectedConfig = newName
			dropdownBtn.Text = newName
			textBox.Text = newName
		else
			data.Name = selected
			saveConfig(selected, data)
		end
		refreshConfigDropdown()
	end)

	-- Load button
	loadBtn.MouseButton1Click:Connect(function()
		local name = Library._selectedConfig
		if not name then return end
		local data = loadConfig(name)
		if data then
			Library:DeserializeAllControls(data)
			refreshConfigDropdown()
			dropdownBtn.Text = name
			textBox.Text = name
		end
	end)

	-- Initial dropdown refresh
	refreshConfigDropdown()
end

-- --------------------------------------------------------------------------
-- Tab switching
-- --------------------------------------------------------------------------
local function switchTab(tabName)
	-- Hide all tab frames
	if Library._tabFrameContainer then
		Library._tabFrameContainer.Visible = false
	end
	if Library._configFrame then
		Library._configFrame.Visible = false
	end
	-- Show selected
	if tabName == "config" then
		if Library._configFrame then
			Library._configFrame.Visible = true
		end
	else
		local frame = tabFrames[tabName]
		if frame then
			frame.Visible = true
		end
	end
	activeTab = tabName
end

