	createUIStroke(keybinds, CONST.Keybinds.StrokeThickness, CONST.Keybinds.StrokeColor)

	local keybindTitle = createInstance("TextLabel", keybinds, {
		Name = "Title",
		Text = CONST.Keybinds.Title,
		TextSize = 14,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		FontFace = CONST.TabButton.Font,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 70, 0, 13),
		Position = UDim2.new(0.32286, 0, 0.06, 0),
		BorderSizePixel = 0,
	})

	local keybindFrame = createInstance("Frame", keybinds, {
		Name = "KeybindFrame",
		Size = CONST.Keybinds.Frame.Size,
		Position = CONST.Keybinds.Frame.Position,
		BackgroundColor3 = CONST.Keybinds.Frame.Background,
		BorderSizePixel = 0,
	})
	keybindDisplayFrame = keybindFrame

	-- Store references
	windowInstance = main
	Library._tabList = tabList
	Library._tabFrameContainer = tabFrameContainer
	Library._configFrame = configFrame
	Library._keybindsFrame = keybinds
	Library._keybindFrame = keybindFrame

	-- Build Config tab content (always present)
	buildConfigTabContent(configFrame)

	-- Create the default "Example" tab for demonstration (optional, but we'll keep it)
	-- We'll create a tab called "Example" with sample controls to show usage
	-- But the library is designed to be used by the user, so we might not create it automatically.
	-- However, we want to show something. We'll create an example tab only if no tabs exist yet.
	-- We'll expose a method to create tabs, so we won't create any by default.
	-- The user will create their own tabs.

	-- Create the Config tab button (always at bottom)
	local configBtn = createInstance("TextButton", tabList, {
		Name = "config",
		Size = CONST.TabButton.Size,
		Position = UDim2.new(0, 0, 0.85687, 0),
		Text = "config",
		TextSize = CONST.TabButton.TextSize,
		TextColor3 = CONST.TabButton.TextColor,
		FontFace = CONST.TabButton.Font,
		BackgroundTransparency = CONST.TabButton.BackgroundTransparency,
		BorderSizePixel = 0,
	})
	-- config button click shows configFrame
	configBtn.MouseButton1Click:Connect(function()
		switchTab("config")
	end)

	-- Make the menu draggable
	local dragging = false
	local dragStart = nil
	local dragOffset = nil
	main.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			dragOffset = main.Position
		end
	end)
	main.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			local newPos = UDim2.new(
				dragOffset.X.Scale + delta.X / screenGui.AbsoluteSize.X,
				0,
				dragOffset.Y.Scale + delta.Y / screenGui.AbsoluteSize.Y,
				0
			)
			main.Position = newPos
		end
	end)

	-- Menu toggle key
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == menuKey then
			toggleMenu()
		end
	end)

	return screenGui, main
end

