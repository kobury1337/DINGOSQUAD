local TabMT, GroupMT = {}, {}

function TabMT:CreateGroup(name, side, opts)
    opts = opts or {}
    local group = {
        name = name,
        side = side or "left",
        fill = opts.Fill ~= false,
        size = opts.Size,
        elements = {},
    }
    table.insert(self._groups, group)
    return setmetatable(group, { __index = GroupMT })
end

local function make_extra(opts, name)
    if not opts then return nil end
    if opts.Keybind then
        return { type = "keybind", key = opts.Keybind,
                 toggletype = opts.ToggleType, callback = opts.Callback }
    end
    if opts.Colors then
        return { type = "double colorpicker",
                 name = opts.ColorNames or { name.." 1", name.." 2" },
                 color = opts.Colors, callback = opts.Callback }
    end
    if opts.Color then
        return { type = "single colorpicker",
                 name = opts.ColorName or (name.." Color"),
                 color = opts.Color, callback = opts.Callback }
    end
    return nil
end

function GroupMT:CreateToggle(name, default, opts)
    opts = opts or {}
    local el = {
        type = "toggle", name = name,
        value = default or false,
        callback = opts.Callback,
        unsafe = opts.Unsafe,
        tooltip = opts.Tooltip,
    }
    el.extra = make_extra({
        Keybind = opts.Keybind, ToggleType = opts.ToggleType,
        Color = opts.Color, ColorName = opts.ColorName,
        Colors = opts.Colors, ColorNames = opts.ColorNames,
        Callback = opts.Callback,
    }, name)
    table.insert(self.elements, el)
    return el
end

function GroupMT:CreateSlider(name, minv, maxv, default, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "slider", name = name,
        value = default or minv,
        minvalue = minv, maxvalue = maxv,
        stradd = opts.Suffix,
        decimal = opts.Decimal,
        stepsize = opts.Step,
        custom = opts.Custom or {},
        callback = opts.Callback,
        tooltip = opts.Tooltip,
    })
end

function GroupMT:CreateDropbox(name, values, default, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "dropbox", name = name,
        value = default or 1,
        values = values,
        callback = opts.Callback,
        tooltip = opts.Tooltip,
    })
end

function GroupMT:CreateCombobox(name, values, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "combobox", name = name,
        values = values,
        callback = opts.Callback,
        tooltip = opts.Tooltip,
    })
end

function GroupMT:CreateButton(name, callback, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "button", name = name,
        callback = callback,
        doubleclick = opts.DoubleClick,
        tooltip = opts.Tooltip,
    })
end

function GroupMT:CreateTextbox(name, default, callback, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "textbox", name = name,
        text = default or "",
        callback = callback,
        file = opts.File,
        tooltip = opts.Tooltip,
    })
end

function GroupMT:CreateKeybind(name, key, callback, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "toggle", name = name, value = false,
        callback = opts.OnToggle,
        tooltip = opts.Tooltip,
        extra = {
            type = "keybind", key = key,
            toggletype = opts.ToggleType or 2,
            callback = callback or opts.Callback,
        },
    })
end

function GroupMT:CreateColorPicker(name, color, callback, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "toggle", name = name, value = false,
        callback = opts.OnToggle,
        tooltip = opts.Tooltip,
        extra = {
            type = "single colorpicker",
            name = opts.ColorName or (name.." Color"),
            color = color,
            callback = callback,
        },
    })
end

function GroupMT:CreateDoubleColorPicker(name, colors, callback, opts)
    opts = opts or {}
    table.insert(self.elements, {
        type = "toggle", name = name, value = false,
        callback = opts.OnToggle,
        tooltip = opts.Tooltip,
        extra = {
            type = "double colorpicker",
            name = opts.ColorNames or { name.." 1", name.." 2" },
