			bindOptions.Name = "BindOptions"
			bindOptions.Size = UDim2.new(0, 88, 0, 77)
			bindOptions.Position = UDim2.new(0.80328, 0, 0.07692, 0)
			bindOptions.BackgroundColor3 = Color3.fromRGB(19, 19, 19)
			bindOptions.BorderSizePixel = 0
			bindOptions.Visible = false
			bindOptions.Parent = bindBtn

			-- Options: ALWAYS, TOGGLE, HOLD
			local optionNames = {"ALWAYS", "TOGGLE", "HOLD"}
			local yOffset = 0.06401
			for _, optName in ipairs(optionNames) do
				local optBtn = Instance.new("TextButton")
				optBtn.Name = optName
				optBtn.Size = UDim2.new(0, 61, 0, 13)
				optBtn.Position = UDim2.new(0.14391, 0, yOffset)
				optBtn.BackgroundTransparency = 1
				optBtn.TextColor3 = Color3.fromRGB(255,255,255)
				optBtn.Text = optName
				optBtn.TextSize = 14
				optBtn.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
				optBtn.Parent = bindOptions
				yOffset = yOffset + 0.35
			end

			-- ColorPicker button (optional)
			local colorPickerBtn = nil
			if enableColorPicker then
				colorPickerBtn = Instance.new("TextButton")
				colorPickerBtn.Name = "ColorPicker"
				colorPickerBtn.Size = UDim2.new(0, 43, 0, 18)
				colorPickerBtn.Position = UDim2.new(16.36364, 0, -0.36364, 0)
				colorPickerBtn.BackgroundColor3 = defaultColor
				colorPickerBtn.BorderSizePixel = 0
				colorPickerBtn.Text = ""
				colorPickerBtn.Parent = toggleBtn
			end

			-- Toggle state
			local active = default
			local keybind = nil
			local mode = "TOGGLE"
			local color = defaultColor

			-- Update appearance
			local function UpdateToggleAppearance()
				toggleBtn.BackgroundColor3 = active and window.ActivationColor or Color3.fromRGB(59,59,59)
				callback(active)
				-- Update keybinds display if visible
				if window.KeybindsFrame.Visible then
					UpdateKeybindsDisplay()
				end
			end

			-- Click toggle
			toggleBtn.MouseButton1Click:Connect(function()
				active = not active
				UpdateToggleAppearance()
			end)

			-- Bind button click: listen for key
			bindBtn.MouseButton1Click:Connect(function()
				if ActiveKeybindListener then return end -- already listening
				bindBtn.Text = "[...]"
				ActiveKeybindListener = function(keyCode)
					if keyCode then
						keybind = keyCode
						bindBtn.Text = "[" .. GetKeyName(keyCode) .. "]"
						ActiveKeybindListener = nil
						UpdateKeybindsDisplay()
					else
						-- canceled or no key
						bindBtn.Text = "[-]"
						ActiveKeybindListener = nil
					end
				end
			end)

			-- Right-click bind button: show options
			bindBtn.MouseButton2Click:Connect(function()
				bindOptions.Visible = not bindOptions.Visible
				if bindOptions.Visible then
					KeybindOptionsOpen = bindOptions
				else
					KeybindOptionsOpen = nil
				end
			end)

			-- Option buttons
			for _, optBtn in ipairs(bindOptions:GetChildren()) do
				if optBtn:IsA("TextButton") then
					optBtn.MouseButton1Click:Connect(function()
						mode = optBtn.Name
						bindOptions.Visible = false
						KeybindOptionsOpen = nil
						UpdateKeybindsDisplay()
					end)
				end
			end

			-- ColorPicker click
			if colorPickerBtn then
				colorPickerBtn.MouseButton1Click:Connect(function()
					OpenColorPicker(color, function(newColor)
						color = newColor
						colorPickerBtn.BackgroundColor3 = color
						if params.CallbackColor then
							params.CallbackColor(color)
						end
					end)
				end)
			end

			-- Store control data
			local controlId = GenerateControlId()
			local controlData = {
				Type = "Toggle",
				ToggleButton = toggleBtn,
				Title = name,
				Active = active,
				Keybind = keybind,
				Mode = mode,
				BindButton = bindBtn,
				BindOptions = bindOptions,
				ColorPicker = colorPickerBtn,
				Color = color,
				Tab = self,
				UpdateAppearance = UpdateToggleAppearance,
			}
			Controls[controlId] = controlData

			-- Init appearance
			UpdateToggleAppearance()

			return controlData
		end

		-- Slider (Bar)
		function tabObj:CreateSlider(params)
			local name = params.Name or "Slider"
			local min = params.Min or 0
			local max = params.Max or 100
			local default = params.Default or 50
			local callback = params.Callback or function() end

			local holder = CreateControlHolder(self.Frame, self.ControlsCount)
			self.ControlsCount = self.ControlsCount + 24

			-- Title label above?
			local title = Instance.new("TextLabel")
			title.Size = UDim2.new(0, 70, 0, 13)
			title.Position = UDim2.new(0.08181, 0, 0, 0)
			title.BackgroundTransparency = 1
			title.TextColor3 = Color3.fromRGB(255,255,255)
			title.Text = name
			title.TextSize = 14
			title.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
			title.Parent = holder

			-- The bar (background)
			local bar = Instance.new("TextButton")
			bar.Name = "Bar"
			bar.Size = UDim2.new(0, 143, 0, 6)
			bar.Position = UDim2.new(0.05833, 0, 0.2824, 0)
			bar.BackgroundColor3 = Color3.fromRGB(59, 59, 59)
			bar.BorderColor3 = Color3.fromRGB(49, 49, 49)
			bar.Text = ""
			bar.TextXAlignment = Enum.TextXAlignment.Left
			bar.Parent = holder

			-- Fill (child frame)
			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.Size = UDim2.new(0, 0, 1, 0)
			fill.BackgroundColor3 = window.ActivationColor
			fill.BorderSizePixel = 0
			fill.Parent = bar

			-- Value label (optional)
			local valueLabel = Instance.new("TextLabel")
			valueLabel.Size = UDim2.new(0, 30, 0, 13)
			valueLabel.Position = UDim2.new(0, 150, 0, -3) -- right of bar
			valueLabel.BackgroundTransparency = 1
			valueLabel.TextColor3 = Color3.fromRGB(255,255,255)
			valueLabel.Text = tostring(default)
			valueLabel.TextSize = 12
			valueLabel.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
			valueLabel.Parent = holder

			-- Slider value
			local sliderValue = math.clamp(default, min, max)

			local function UpdateSliderAppearance()
				local percent = (sliderValue - min) / (max - min)
				fill.Size = UDim2.new(percent, 0, 1, 0)
				valueLabel.Text = tostring(math.floor(sliderValue))
				callback(sliderValue)
			end

			-- Click/drag on bar
			local dragging = false
			bar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = true
				end
			end)
			bar.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = false
				end
			end)

			local function UpdateFromMouse(input)
				if not dragging and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
				local pos = input.Position.X - bar.AbsolutePosition.X
				local width = bar.AbsoluteSize.X
				local percent = math.clamp(pos / width, 0, 1)
				sliderValue = min + (max - min) * percent
				UpdateSliderAppearance()
			end

			bar.MouseButton1Click:Connect(UpdateFromMouse)
			bar.MouseMoved:Connect(function(input)
				if dragging then
					UpdateFromMouse(input)
				end
			end)

			-- Store control
			local controlId = GenerateControlId()
			local controlData = {
				Type = "Slider",
				SliderValue = sliderValue,
				Min = min,
				Max = max,
				Bar = bar,
				Fill = fill,
				ValueLabel = valueLabel,
				Title = name,
				Tab = self,
				UpdateAppearance = UpdateSliderAppearance,
			}
			Controls[controlId] = controlData

			UpdateSliderAppearance()
			return controlData
		end

		-- Dropdown
		function tabObj:CreateDropdown(params)
			local name = params.Name or "Dropdown"
			local options = params.Options or {}
			local default = params.Default or options[1] or ""
			local callback = params.Callback or function() end

			local holder = CreateControlHolder(self.Frame, self.ControlsCount)
			self.ControlsCount = self.ControlsCount + 24

			local dropdownBtn = Instance.new("TextButton")
			dropdownBtn.Name = "DropdownButton"
			dropdownBtn.Size = UDim2.new(0, 126, 0, 17)
			dropdownBtn.Position = UDim2.new(0.05833, 0, 0, 0)
			dropdownBtn.BackgroundColor3 = Color3.fromRGB(59, 59, 59)
			dropdownBtn.BorderColor3 = Color3.fromRGB(49, 49, 49)
			dropdownBtn.Text = ""
			dropdownBtn.TextXAlignment = Enum.TextXAlignment.Left
			dropdownBtn.TextSize = 13
			dropdownBtn.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
			dropdownBtn.Parent = holder

			local title = Instance.new("TextLabel")
			title.Name = "Title"
			title.Size = UDim2.new(0, 70, 0, 13)
			title.Position = UDim2.new(0.08181, 0, -1.31959, 0)
			title.BackgroundTransparency = 1
			title.TextColor3 = Color3.fromRGB(255,255,255)
			title.Text = name
			title.TextSize = 14
			title.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
			title.Parent = dropdownBtn

			local dropdownFrame = Instance.new("Frame")
			dropdownFrame.Name = "Frame"
			dropdownFrame.Size = UDim2.new(0, 126, 0, #options * 26)
			dropdownFrame.Position = UDim2.new(0, 0, 1, 0)
			dropdownFrame.BackgroundColor3 = Color3.fromRGB(59, 59, 59)
			dropdownFrame.BorderColor3 = Color3.fromRGB(49, 49, 49)
			dropdownFrame.Visible = false
			dropdownFrame.Parent = dropdownBtn

			-- Populate options
			local optionButtons = {}
			for i, opt in ipairs(options) do
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(0, 126, 0, 26)
				btn.Position = UDim2.new(0, 0, 0, (i-1)*26)
				btn.BackgroundTransparency = 1
				btn.TextColor3 = Color3.fromRGB(255,255,255)
				btn.Text = opt
				btn.TextSize = 14
				btn.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json")
				btn.Parent = dropdownFrame
				table.insert(optionButtons, btn)
			end

			local selectedValue = default
			dropdownBtn.Text = selectedValue

			-- Click dropdown button: toggle frame, close others
			dropdownBtn.MouseButton1Click:Connect(function()
				if ActiveDropdown and ActiveDropdown ~= dropdownFrame then
					ActiveDropdown.Visible = false
				end
				dropdownFrame.Visible = not dropdownFrame.Visible
				ActiveDropdown = dropdownFrame.Visible and dropdownFrame or nil
			end)

			-- Option clicks
			for i, btn in ipairs(optionButtons) do
				btn.MouseButton1Click:Connect(function()
					selectedValue = btn.Text
					dropdownBtn.Text = selectedValue
					dropdownFrame.Visible = false
					ActiveDropdown = nil
					callback(selectedValue)
					-- Update control state
					controlData.DropdownValue = selectedValue
				end)
			end

			-- Store control
			local controlId = GenerateControlId()
			local controlData = {
				Type = "Dropdown",
				DropdownButton = dropdownBtn,
				DropdownFrame = dropdownFrame,
				Options = options,
				DropdownValue = selectedValue,
				Title = name,
				Tab = self,
				OptionButtons = optionButtons,
				UpdateDisplay = function()
					dropdownBtn.Text = selectedValue
				end,
			}
			Controls[controlId] = controlData

			return controlData
		end

		-- Insert tab into window's list
		table.insert(window.Tabs, tabObj)

		return tabObj
	end

