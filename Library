                local tt = string.split(lines[i+s], "|")
                if menu.options[tt[1]] and menu.options[tt[1]][tt[2]] and menu.options[tt[1]][tt[2]][tt[3]] then
                    local num = tonumber(tt[4])
                    if num > #menu.options[tt[1]][tt[2]][tt[3]][6] then num = #menu.options[tt[1]][tt[2]][tt[3]][6]
                    elseif num < 0 then num = 1 end
