----------------------------------------------------------------
-- TAB POSITIONING
----------------------------------------------------------------

local function UpdateTabButtons(Window)
    local Tabs = Window.Tabs

    for Index, Tab in ipairs(Tabs) do
        if Tab.Button then
            Tab.Button.LayoutOrder = Index
        end
    end

    -- Config always remains visually at the bottom.
    Window.UI.ConfigButton.LayoutOrder = 999999
end

----------------------------------------------------------------
-- ACTIVATE TAB
----------------------------------------------------------------

local function ActivateTab(Window, Tab)
    if Window.Destroyed then
        return
    end

    if not Tab or Tab.Destroyed then
        return
    end

    Window.ActiveTab = Tab

    for _, OtherTab in ipairs(Window.Tabs) do
        if OtherTab.UI and OtherTab.UI.Frame then
            OtherTab.UI.Frame.Visible = OtherTab == Tab
        end

        if OtherTab.Button then
            if OtherTab == Tab then
                OtherTab.Button.TextColor3 = Window.ActivationColor
            else
                OtherTab.Button.TextColor3 = COLORS.White
            end
        end
    end

    if Window.ConfigUI and Window.ConfigUI.Frame then
        Window.ConfigUI.Frame.Visible = false
    end

    Window.UI.ConfigButton.TextColor3 = COLORS.White
end

----------------------------------------------------------------
-- ACTIVATE CONFIG
----------------------------------------------------------------

local function ActivateConfig(Window)
    if Window.Destroyed then
        return
    end

    Window.ActiveTab = nil

    for _, Tab in ipairs(Window.Tabs) do
        if Tab.UI and Tab.UI.Frame then
            Tab.UI.Frame.Visible = false
        end

        if Tab.Button then
            Tab.Button.TextColor3 = COLORS.White
        end
    end

    if Window.ConfigUI and Window.ConfigUI.Frame then
        Window.ConfigUI.Frame.Visible = true
    end

    Window.UI.ConfigButton.TextColor3 = Window.ActivationColor
end

----------------------------------------------------------------
-- CREATE WINDOW
----------------------------------------------------------------

local function CreateWindowObject(Settings)
    Settings = Settings or {}

    local Window = {
        Name = Settings.Name or "DINGOSQUAD",

        ActivationColor =
            Settings.ActivationColor
            or DEFAULT_ACTIVATION_COLOR,

        Tabs = {},

        Controls = {},

        State = {},

        Connections = {},

        Destroyed = false,

        ActiveTab = nil,

        NextTabID = 0,
    }

    ----------------------------------------------------------------
    -- CREATE UI
    ----------------------------------------------------------------

    CreateWindowUI(Window)

    CreateConfigFrame(Window)

    ----------------------------------------------------------------
    -- CONFIG BUTTON
    ----------------------------------------------------------------

    table.insert(
        Window.Connections,
        Window.UI.ConfigButton.MouseButton1Click:Connect(function()
            ActivateConfig(Window)
        end)
    )

    ----------------------------------------------------------------
    -- CREATE TAB
    ----------------------------------------------------------------

    function Window:CreateTab(Name)
        assert(
            type(Name) == "string" and Name ~= "",
            "DINGOSQUAD: Tab name must be a non-empty string"
        )

        assert(
            not self.Destroyed,
            "DINGOSQUAD: Cannot create a tab on a destroyed window"
        )

        -- Prevent duplicate tab names.
        for _, ExistingTab in ipairs(self.Tabs) do
            if ExistingTab.Name:lower() == Name:lower() then
                error(
                    "DINGOSQUAD: A tab named '" .. Name .. "' already exists",
                    2
                )
            end
        end

        self.NextTabID += 1

        local Tab = {
            ID = self.NextTabID,

            Name = Name,

            Window = self,

            Controls = {},

            Connections = {},

            Destroyed = false,
        }

        ----------------------------------------------------------------
        -- BUTTON
        ----------------------------------------------------------------

        Tab.Button = CreateTabButton(
            self.UI.DynamicTabContainer,
            Name
        )

        ----------------------------------------------------------------
        -- FRAME
        ----------------------------------------------------------------

        CreateTabFrame(self, Tab)

        ----------------------------------------------------------------
        -- BUTTON CLICK
        ----------------------------------------------------------------

        table.insert(
            Tab.Connections,
            Tab.Button.MouseButton1Click:Connect(function()
                ActivateTab(self, Tab)
            end)
        )

        ----------------------------------------------------------------
        -- ADD TO REGISTRY
        ----------------------------------------------------------------

        table.insert(self.Tabs, Tab)

        self.State.Tabs[Tab.ID] = {
            Name = Name,
        }

        UpdateTabButtons(self)

        ----------------------------------------------------------------
        -- FIRST TAB AUTOMATICALLY OPENS
        ----------------------------------------------------------------

        if not self.ActiveTab then
            ActivateTab(self, Tab)
        end

        return Tab
    end

    ----------------------------------------------------------------
    -- GET TAB
    ----------------------------------------------------------------

    function Window:GetTab(Name)
        if type(Name) ~= "string" then
            return nil
        end

        for _, Tab in ipairs(self.Tabs) do
            if Tab.Name:lower() == Name:lower() then
                return Tab
            end
        end

        return nil
    end

    ----------------------------------------------------------------
    -- ACTIVATE TAB
    ----------------------------------------------------------------

    function Window:SelectTab(Name)
        local Tab

        if type(Name) == "table" then
            Tab = Name
        else
            Tab = self:GetTab(Name)
        end

        if not Tab then
            return false
        end

        ActivateTab(self, Tab)

        return true
    end

    ----------------------------------------------------------------
    -- TAB COUNT
    ----------------------------------------------------------------

    function Window:GetTabCount()
        return #self.Tabs
    end

    ----------------------------------------------------------------
    -- SET ACTIVATION COLOR
    ----------------------------------------------------------------

    function Window:SetActivationColor(Color)
        assert(
            typeof(Color) == "Color3",
            "DINGOSQUAD: ActivationColor must be a Color3"
        )

        self.ActivationColor = Color

        if self.ActiveTab then
            self.ActiveTab.Button.TextColor3 = Color
        end

        if self.ConfigUI.Frame.Visible then
            self.UI.ConfigButton.TextColor3 = Color
        end
    end

    ----------------------------------------------------------------
    -- DESTROY TAB
    ----------------------------------------------------------------

    function Window:DestroyTab(TabOrName)
        local Tab

        if type(TabOrName) == "string" then
            Tab = self:GetTab(TabOrName)
        elseif type(TabOrName) == "table" then
            Tab = TabOrName
        end

        if not Tab or Tab.Destroyed then
            return false
        end

        if Tab.Window ~= self then
            return false
        end

        -- Disconnect tab connections.
        DisconnectConnections(Tab.Connections)

        -- Destroy controls belonging to the tab.
        for _, Control in ipairs(Tab.Controls) do
            if Control.Destroy then
                pcall(function()
                    Control:Destroy()
                end)
            end
        end

        table.clear(Tab.Controls)

        -- Destroy UI.
        if Tab.Button then
            Tab.Button:Destroy()
            Tab.Button = nil
        end

        if Tab.UI and Tab.UI.Frame then
            Tab.UI.Frame:Destroy()
        end

        Tab.Destroyed = true

        -- Remove from tabs array.
        for Index, ExistingTab in ipairs(self.Tabs) do
            if ExistingTab == Tab then
                table.remove(self.Tabs, Index)
                break
            end
        end

        self.State.Tabs[Tab.ID] = nil

        UpdateTabButtons(self)

        -- Pick another tab if the destroyed one was active.
        if self.ActiveTab == Tab then
            self.ActiveTab = nil

            local NewTab = self.Tabs[1]

            if NewTab then
                ActivateTab(self, NewTab)
            else
                ActivateConfig(self)
            end
        end

        return true
    end

    ----------------------------------------------------------------
    -- GET STATE
    ----------------------------------------------------------------

    function Window:GetState()
        return self.State
    end

    ----------------------------------------------------------------
    -- DESTROY WINDOW
    ----------------------------------------------------------------

    function Window:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        ----------------------------------------------------------------
        -- Destroy tabs
        ----------------------------------------------------------------

        for _, Tab in ipairs(self.Tabs) do
            Tab.Destroyed = true

            DisconnectConnections(Tab.Connections)

            for _, Control in ipairs(Tab.Controls) do
                if Control.Destroy then
                    pcall(function()
                        Control:Destroy()
                    end)
                end
            end

            table.clear(Tab.Controls)
        end

        table.clear(self.Tabs)

        ----------------------------------------------------------------
        -- Disconnect window connections
        ----------------------------------------------------------------

        DisconnectConnections(self.Connections)

        ----------------------------------------------------------------
        -- Destroy UI
        ----------------------------------------------------------------

        if self.UI and self.UI.ScreenGui then
            self.UI.ScreenGui:Destroy()
        end

        ----------------------------------------------------------------
        -- Remove from Library
        ----------------------------------------------------------------

        for Index, ExistingWindow in ipairs(Library.Windows) do
            if ExistingWindow == self then
                table.remove(Library.Windows, Index)
                break
            end
        end

        table.clear(self.Controls)
        table.clear(self.State)
    end

    ----------------------------------------------------------------
    -- STORE WINDOW
    ----------------------------------------------------------------

    table.insert(Library.Windows, Window)

    return Window
end

----------------------------------------------------------------
-- PUBLIC API
----------------------------------------------------------------

function Library:CreateWindow(Settings)
    return CreateWindowObject(Settings)
end

----------------------------------------------------------------
-- GET WINDOWS
----------------------------------------------------------------

function Library:GetWindows()
    return self.Windows
end

----------------------------------------------------------------
-- DESTROY ALL WINDOWS
----------------------------------------------------------------

function Library:DestroyAll()
    for _, Window in ipairs(table.clone(self.Windows)) do
        if Window and Window.Destroy then
            Window:Destroy()
        end
    end
end

return Library
