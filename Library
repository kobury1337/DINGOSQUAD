local function CreateSlider(Tab, Settings)
    Settings = Settings or {}
    assert(type(Settings.Name) == "string" and Settings.Name ~= "", "DINGOSQUAD: Slider name must be a non-empty string")
    assert(type(Settings.Min) == "number", "DINGOSQUAD: Slider Min must be a number")
    assert(type(Settings.Max) == "number" and Settings.Max > Settings.Min, "DINGOSQUAD: Slider Max must be greater than Min")
    assert(Settings.Default == nil or type(Settings.Default) == "number", "DINGOSQUAD: Slider Default must be a number")
    assert(Settings.Increment == nil or (type(Settings.Increment) == "number" and Settings.Increment > 0), "DINGOSQUAD: Slider Increment must be greater than 0")
    assert(Settings.Callback == nil or type(Settings.Callback) == "function", "DINGOSQUAD: Slider callback must be a function")
    local Window = Tab.Window; local Min = Settings.Min; local Max = Settings.Max; local Increment = Settings.Increment or 1; local Default = Settings.Default or Min
    local Slider = {Name = Settings.Name, Type = "Slider", Min = Min, Max = Max, Increment = Increment, Value = Default, Callback = Settings.Callback or function() end, Connections = {}}
    RegisterControl(Window, Tab, Slider)
    Slider.Frame = Create("Frame", {Name = "Slider_" .. Slider.ID, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 180, 0, 28), Position = UDim2.new(0, 28, 0, ControlYOffset(Tab)), Parent = Tab.ControlsContainer})
    Slider.Title = Create("TextLabel", {Name = "Title", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 120, 0, 13), Text = Settings.Name, TextColor3 = COLORS.Text, TextSize = 14, Font = FONTS.Main, TextXAlignment = Enum.TextXAlignment.Left, Parent = Slider.Frame})
    Slider.ValueLabel = Create("TextLabel", {Name = "Value", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 55, 0, 13), Position = UDim2.new(0, 125, 0, 0), TextColor3 = COLORS.Text, TextSize = 13, Font = FONTS.Main, TextXAlignment = Enum.TextXAlignment.Right, Parent = Slider.Frame})
    Slider.Track = Create("TextButton", {Name = "Track", AutoButtonColor = false, BackgroundColor3 = COLORS.SliderBackground, BorderSizePixel = 1, BorderColor3 = COLORS.ControlBorder, Size = UDim2.new(0, 180, 0, 8), Position = UDim2.new(0, 0, 0, 17), Text = "", Parent = Slider.Frame})
    Slider.Fill = Create("Frame", {Name = "Fill", BackgroundColor3 = Window.ActivationColor, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = Slider.Track})
    Slider.Knob = Create("Frame", {Name = "Knob", BackgroundColor3 = Window.ActivationColor, BorderSizePixel = 0, Size = UDim2.new(0, 5, 1, 4), Position = UDim2.new(0, -2, 0, -2), Parent = Slider.Track})
    local Dragging = false
    local function Clamp(Value) local Steps = math.floor(((Value - Min) / Increment) + 0.5); return math.clamp(Min + Steps * Increment, Min, Max) end
    local function UpdateVisual() local Alpha = math.clamp((Slider.Value - Min) / (Max - Min), 0, 1); Slider.Fill.Size = UDim2.new(Alpha, 0, 1, 0); Slider.Knob.Position = UDim2.new(Alpha, -2, 0, -2); Slider.ValueLabel.Text = Slider.Value % 1 == 0 and tostring(math.floor(Slider.Value)) or tostring(Slider.Value) end
    local function Fire() local OK, Err = pcall(Slider.Callback, Slider.Value); if not OK then warn("[DINGOSQUAD] Slider callback error:", Err) end end
    function Slider:SetValue(Value, FireCallback) assert(type(Value) == "number", "DINGOSQUAD: Slider value must be a number"); if self.Destroyed then return end; self.Value = Clamp(Value); UpdateVisual(); if FireCallback ~= false then Fire() end end
    function Slider:GetValue() return self.Value end
    local function UpdateFromInput(Input) local Alpha = math.clamp((Input.Position.X - Slider.Track.AbsolutePosition.X) / math.max(Slider.Track.AbsoluteSize.X, 1), 0, 1); Slider:SetValue(Min + (Max - Min) * Alpha) end
    Slider.Connections[#Slider.Connections + 1] = Slider.Track.InputBegan:Connect(function(Input) if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then Dragging = true; UpdateFromInput(Input) end end)
    Slider.Connections[#Slider.Connections + 1] = UserInputService.InputChanged:Connect(function(Input) if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then UpdateFromInput(Input) end end)
    Slider.Connections[#Slider.Connections + 1] = UserInputService.InputEnded:Connect(function(Input) if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then Dragging = false end end)
    function Slider:Destroy() if self.Destroyed then return end; self.Destroyed = true; Dragging = false; DisconnectAll(self.Connections); if self.Frame then self.Frame:Destroy() end; Window.Controls[self.ID] = nil; Tab.Controls[self.ID] = nil end
    Slider:SetValue(Default, false); table.insert(Tab.ControlOrder, Slider); return Slider
end

local function CreateDropdown(Tab, Settings)
    Settings = Settings or {}
    assert(type(Settings.Name) == "string" and Settings.Name ~= "", "DINGOSQUAD: Dropdown name must be a non-empty string")
    assert(type(Settings.Options) == "table", "DINGOSQUAD: Dropdown Options must be a table")
    assert(Settings.Default == nil or type(Settings.Default) == "string", "DINGOSQUAD: Dropdown Default must be a string or nil")
    assert(Settings.Callback == nil or type(Settings.Callback) == "function", "DINGOSQUAD: Dropdown callback must be a function")
    local Window = Tab.Window
    local Dropdown = {Name = Settings.Name, Type = "Dropdown", Options = {}, Value = nil, Callback = Settings.Callback or function() end, Connections = {}, Open = false}
    for _, Option in ipairs(Settings.Options) do table.insert(Dropdown.Options, tostring(Option)) end
    RegisterControl(Window, Tab, Dropdown)

    local Container = Create("Frame", {Name = "Dropdown_" .. Dropdown.ID, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 180, 0, 22), Position = UDim2.new(0, 28, 0, ControlYOffset(Tab)), Parent = Tab.ControlsContainer})
    Dropdown.Frame = Container
    Dropdown.Button = Create("TextButton", {
        Name = "Button", AutoButtonColor = false, BackgroundColor3 = COLORS.ControlBackground, BorderSizePixel = 1, BorderColor3 = COLORS.ControlBorder,
        Size = UDim2.new(0, 180, 0, 20), Text = "", TextColor3 = COLORS.Text, TextSize = 13, Font = FONTS.Main, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container
    })
    local Title = Create("TextLabel", {Name = "Title", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 75, 1, 0), Position = UDim2.new(0, 7, 0, 0), Text = Settings.Name, TextColor3 = COLORS.Text, TextSize = 13, Font = FONTS.Main, TextXAlignment = Enum.TextXAlignment.Left, Parent = Dropdown.Button})
    Dropdown.ValueLabel = Create("TextLabel", {Name = "Value", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 85, 1, 0), Position = UDim2.new(0, 88, 0, 0), TextColor3 = COLORS.Text, TextSize = 13, Font = FONTS.Main, TextXAlignment = Enum.TextXAlignment.Right, Parent = Dropdown.Button})
    Dropdown.Arrow = Create("TextLabel", {Name = "Arrow", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 15, 1, 0), Position = UDim2.new(1, -18, 0, 0), Text = "v", TextColor3 = COLORS.Text, TextSize = 12, Font = FONTS.Main, Parent = Dropdown.Button})
    Dropdown.List = Create("Frame", {Name = "Options", Visible = false, BackgroundColor3 = COLORS.DropdownBackground, BorderSizePixel = 1, BorderColor3 = COLORS.ControlBorder, ClipsDescendants = true, Size = UDim2.new(0, 180, 0, 0), Position = UDim2.new(0, 0, 0, 21), ZIndex = 20, Parent = Container})
    local ListLayout = Create("UIListLayout", {FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0), Parent = Dropdown.List})
    local function Fire() local OK, Err = pcall(Dropdown.Callback, Dropdown.Value); if not OK then warn("[DINGOSQUAD] Dropdown callback error:", Err) end end
    local function RefreshOptions()
        for _, Child in ipairs(Dropdown.List:GetChildren()) do if Child:IsA("TextButton") then Child:Destroy() end end
        for Index, Option in ipairs(Dropdown.Options) do
            local OptionButton = Create("TextButton", {Name = "Option_" .. Index, AutoButtonColor = false, BackgroundColor3 = COLORS.DropdownBackground, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 20), Text = Option, TextColor3 = COLORS.Text, TextSize = 13, Font = FONTS.Main, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = Dropdown.List})
            Create("UIPadding", {PaddingLeft = UDim.new(0, 7), Parent = OptionButton})
            Dropdown.Connections[#Dropdown.Connections + 1] = OptionButton.MouseButton1Click:Connect(function() Dropdown:SetValue(Option) end)
        end
        Dropdown.List.Size = UDim2.new(0, 180, 0, math.min(#Dropdown.Options * 20, 160))
    end
    local function UpdateVisual() Dropdown.ValueLabel.Text = Dropdown.Value or "-"; Dropdown.Arrow.Text = Dropdown.Open and "^" or "v" end
    function Dropdown:SetValue(Value, FireCallback)
        if self.Destroyed then return end
        Value = tostring(Value)
        local Found = false
        for _, Option in ipairs(self.Options) do if Option == Value then Found = true; break end end
        if not Found then return end
        self.Value = Value; self.Open = false; self.List.Visible = false; UpdateVisual(); if FireCallback ~= false then Fire() end
    end
    function Dropdown:GetValue() return self.Value end
    function Dropdown:SetOptions(Options)
        assert(type(Options) == "table", "DINGOSQUAD: Dropdown Options must be a table")
        self.Options = {}; for _, Option in ipairs(Options) do table.insert(self.Options, tostring(Option)) end
        self.Value = nil; if self.Options[1] then self.Value = self.Options[1] end; RefreshOptions(); UpdateVisual()
    end
    Dropdown.Connections[#Dropdown.Connections + 1] = Dropdown.Button.MouseButton1Click:Connect(function()
        if Dropdown.Destroyed then return end
        Dropdown.Open = not Dropdown.Open; Dropdown.List.Visible = Dropdown.Open; UpdateVisual()
    end)
    function Dropdown:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true; self.Open = false; DisconnectAll(self.Connections); if self.Frame then self.Frame:Destroy() end
        Window.Controls[self.ID] = nil; Tab.Controls[self.ID] = nil
    end
    RefreshOptions()
    if Settings.Default ~= nil then Dropdown:SetValue(Settings.Default, false) elseif Dropdown.Options[1] then Dropdown:SetValue(Dropdown.Options[1], false) end
    table.insert(Tab.ControlOrder, Dropdown)
    return Dropdown
end

local function CreateTabObject(Window, Name)
    Window.NextTabID += 1
    return {ID = Window.NextTabID, Name = Name, Window = Window, Frame = nil, Button = nil, Controls = {}, ControlOrder = {}, Connections = {}, Destroyed = false}
end

local function AddTabAPI(Tab)
    function Tab:CreateButton(Settings) return CreateButton(self, Settings) end
    function Tab:CreateToggle(Settings) return CreateToggle(self, Settings) end
    function Tab:CreateSlider(Settings) return CreateSlider(self, Settings) end
    function Tab:CreateDropdown(Settings) return CreateDropdown(self, Settings) end
    return Tab
end

local function CreateWindowObject(Settings)
    Settings = Settings or {}
    local Window = {Name = Settings.Name or "DINGOSQUAD", ActivationColor = Settings.ActivationColor or DEFAULT_ACTIVATION_COLOR, Tabs = {}, Controls = {}, State = {Tabs = {}, Controls = {}}, Connections = {}, Destroyed = false, ActiveTab = nil, NextTabID = 0, NextControlID = 0}
    CreateWindowUI(Window)
    function Window:SelectTab(Tab)
        if self.Destroyed or not Tab or Tab.Destroyed then return end
        if self.ActiveTab then if self.ActiveTab.Frame then self.ActiveTab.Frame.Visible = false end; if self.ActiveTab.Button then self.ActiveTab.Button.TextColor3 = COLORS.Text end end
        self.ActiveTab = Tab; Tab.Frame.Visible = true; Tab.Button.TextColor3 = self.ActivationColor
    end
    function Window:CreateTab(Name)
        assert(type(Name) == "string" and Name ~= "", "DINGOSQUAD: Tab name must be a non-empty string")
        for _, Existing in ipairs(self.Tabs) do if Existing.Name == Name then error("DINGOSQUAD: A tab named '" .. Name .. "' already exists") end end
        local Tab = AddTabAPI(CreateTabObject(self, Name)); CreateTabFrame(self, Tab)
        Tab.Button = Create("TextButton", {Name = "Tab_" .. Tab.ID, AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 86, 0, 24), Text = Name, TextColor3 = COLORS.Text, TextSize = 16, Font = FONTS.Main, Parent = self.DynamicTabContainer})
        Tab.Connections[#Tab.Connections + 1] = Tab.Button.MouseButton1Click:Connect(function() self:SelectTab(Tab) end)
        table.insert(self.Tabs, Tab); self.State.Tabs[Tab.ID] = {Name = Tab.Name}; if #self.Tabs == 1 then self:SelectTab(Tab) end
        return Tab
    end
    function Window:GetTab(Name) for _, Tab in ipairs(self.Tabs) do if Tab.Name == Name then return Tab end end end
    function Window:SetActivationColor(Color)
        assert(typeof(Color) == "Color3", "DINGOSQUAD: ActivationColor must be a Color3")
        self.ActivationColor = Color
        if self.ActiveTab and self.ActiveTab.Button then self.ActiveTab.Button.TextColor3 = Color end
        for _, Control in pairs(self.Controls) do
            if Control.Type == "Toggle" and Control.ToggleButton and Control.Value then Control.ToggleButton.BackgroundColor3 = Color
            elseif Control.Type == "Slider" and Control.Fill and Control.Knob then Control.Fill.BackgroundColor3 = Color; Control.Knob.BackgroundColor3 = Color end
        end
    end
    function Window:GetTabCount() return #self.Tabs end
    function Window:DestroyTab(Tab)
        if not Tab or Tab.Destroyed then return end
        local Controls = {}; for _, Control in pairs(Tab.Controls) do table.insert(Controls, Control) end; for _, Control in ipairs(Controls) do Control:Destroy() end
        Tab.Destroyed = true; DisconnectAll(Tab.Connections); if Tab.Button then Tab.Button:Destroy() end; if Tab.Frame then Tab.Frame:Destroy() end; self.State.Tabs[Tab.ID] = nil
        for Index, Existing in ipairs(self.Tabs) do if Existing == Tab then table.remove(self.Tabs, Index); break end end
        if self.ActiveTab == Tab then self.ActiveTab = nil; if self.Tabs[1] then self:SelectTab(self.Tabs[1]) end end
    end
    function Window:GetState() return self.State end
    function Window:Destroy()
        if self.Destroyed then return end
        local Tabs = table.clone(self.Tabs); self.Destroyed = true
