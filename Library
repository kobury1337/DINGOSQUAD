-- =========================================================================
-- Utilities
-- =========================================================================
local function map(X, A, B, C, D) return (X - A) / (B - A) * (D - C) + C end
local function clamp(a, lo, hi)
    if a > hi then return hi
    elseif a < lo then return lo
    else return a end
end
local function CreateThread(f, ...)
    local t = coroutine.create(f); coroutine.resume(t, ...); return t
end
local function MultiThreadList(obj, ...)
    local n = #obj
    if n > 0 then
        for i = 1, n do
            local t = obj[i]
            if type(t) == "table" then
                local d = #t
                assert(d ~= 0, "table inserted was not an array or was empty")
                assert(d < 3, ("invalid number of arguments (%d)"):format(d))
                assert(type(t[1]) == "function",
                    ("invalid argument #1: expected 'function', got '%s'"):format(tostring(type(t[1]))))
                CreateThread(t[1], unpack(t[2]))
            else
                CreateThread(t, ...)
            end
        end
    else
        for _, v in pairs(obj) do CreateThread(v, ...) end
    end
end

