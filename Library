end
local function DisconnectAll(T)
    for _,C in ipairs(T) do if C then C:Disconnect() end end
    table.clear(T)
end
local function Register(Window, Tab, Control)
    Window.NextControlID += 1
    Control.ID = Window.NextControlID
    Control.Destroyed = false
    Window.Controls[Control.ID] = Control
    Tab.Controls[Control.ID] = Control
    return Control
end
