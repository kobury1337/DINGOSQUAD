        local s = Drawing.new("Image")
        s.Visible = visible; s.Position = Vector2.new(x, y); s.Size = Vector2.new(w, h)
        s.Transparency = transparency; s.Data = data
        table.insert(t, s)
        if not table.find(allrender, t) then table.insert(allrender, t) end
    end
