	local function SaveConfig(name)
		-- Collect all control states
		local state = {}
		for id, control in pairs(Controls) do
			local data = {}
			data.Type = control.Type
			if control.Type == "Toggle" then
				data.Value = control.ToggleButton.Active
				if control.Keybind then
					data.Keybind = tostring(control.Keybind)
					data.Mode = control.Mode or "TOGGLE"
				end
			elseif control.Type == "Slider" then
				data.Value = control.SliderValue
			elseif control.Type == "Dropdown" then
				data.Value = control.DropdownValue
			elseif control.Type == "ColorPicker" then
				data.Value = {
					R = control.Color.R * 255,
					G = control.Color.G * 255,
					B = control.Color.B * 255
				}
			elseif control.Type == "Button" then
				-- no state to save
			end
			state[id] = data
		end

		local configData = {
			Name = name,
			Controls = state
		}

		local success = WriteConfigFile(name, configData)
		if success then
			print("Config saved: " .. name)
			RefreshConfigDropdown()
		else
			warn("Failed to save config")
		end
	end

	local function OverrideConfig(name, newName)
		local data = ReadConfigFile(name)
		if not data then
			warn("Config not found: " .. name)
			return
		end
		if newName and newName ~= name then
			-- rename: read, then write new, then delete old
			local success = WriteConfigFile(newName, data)
			if success then
				-- delete old
				local oldPath = CONFIG_FOLDER .. name .. CONFIG_EXTENSION
				if delfile then delfile(oldPath) end
				print("Config overridden and renamed to: " .. newName)
				RefreshConfigDropdown()
			else
				warn("Failed to override config")
			end
		else
			-- override same name
			local success = WriteConfigFile(name, data)
			if success then
				print("Config overridden: " .. name)
				RefreshConfigDropdown()
			else
				warn("Failed to override config")
			end
		end
	end

	local function LoadConfig(name)
		local data = ReadConfigFile(name)
		if not data then
			warn("Config not found: " .. name)
			return
		end

		local state = data.Controls
		for id, controlData in pairs(state) do
			local control = Controls[id]
			if control then
				if control.Type == "Toggle" then
					if controlData.Value ~= nil then
						control.ToggleButton.Active = controlData.Value
						control.UpdateAppearance()
					end
					if controlData.Keybind then
						local key = Enum.KeyCode[controlData.Keybind]
						if key then
							control.Keybind = key
							control.BindButton.Text = "[" .. GetKeyName(key) .. "]"
						end
					end
					if controlData.Mode then
						control.Mode = controlData.Mode
					end
				elseif control.Type == "Slider" then
					if controlData.Value ~= nil then
						control.SliderValue = math.clamp(controlData.Value, control.Min, control.Max)
						control.UpdateAppearance()
					end
				elseif control.Type == "Dropdown" then
					if controlData.Value ~= nil then
						control.DropdownValue = controlData.Value
						control.UpdateDisplay()
					end
				elseif control.Type == "ColorPicker" then
					if controlData.Value then
						local c = Color3.fromRGB(
							controlData.Value.R or 255,
							controlData.Value.G or 0,
							controlData.Value.B or 0
						)
						control.Color = c
						control.ColorButton.BackgroundColor3 = c
					end
				end
			end
		end

		-- Refresh keybinds display
		UpdateKeybindsDisplay()

		print("Config loaded: " .. name)
	end

